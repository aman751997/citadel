---
// Interview answer at three depths, hidden until the reader chooses to look (think first). Usage in MDX:
//   <AnswerModes id="rabbit-vs-kafka" q="Why did you choose RabbitMQ over Kafka?">
//     <Fragment slot="short">30-second answer (markdown ok)</Fragment>
//     <Fragment slot="medium">2-minute answer</Fragment>
//     <Fragment slot="deep">Detailed technical explanation</Fragment>
//   </AnswerModes>
// Any subset of slots may be given. State (self-check, last tab): citadel-answer-v1:<pathname>:<id>.
// Without JS every depth is shown, one after another.
interface Props { id: string; q: string }
const { id, q } = Astro.props;
const modes = [
  { slot: 'short', label: '30 seconds' },
  { slot: 'medium', label: '2 minutes' },
  { slot: 'deep', label: 'Detailed' },
].filter((m) => Astro.slots.has(m.slot));
---
<section class="am" data-am data-id={id} aria-label={q}>
  <p class="am-q"><span class="am-tag">Interview question</span>{q}</p>
  <div class="am-controls" data-controls hidden>
    <label class="am-self"><input type="checkbox" data-self /> I answered it myself first</label>
    <button type="button" class="am-show" data-show aria-expanded="false" aria-controls={`am-${id}-body`}>Show model answer</button>
  </div>
  <div class="am-body" id={`am-${id}-body`} data-body>
    <div class="am-tabs" role="tablist" aria-label="Answer depth" data-tabs hidden>
      {modes.map((m, i) => (
        <button type="button" role="tab" id={`am-${id}-t-${m.slot}`} aria-controls={`am-${id}-p-${m.slot}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={m.slot}>{m.label}</button>
      ))}
    </div>
    {Astro.slots.has('short') && (
      <div class="am-panel" role="tabpanel" id={`am-${id}-p-short`} aria-labelledby={`am-${id}-t-short`} tabindex="0" data-panel="short">
        <h5 class="am-h">30 seconds</h5>
        <slot name="short" />
      </div>
    )}
    {Astro.slots.has('medium') && (
      <div class="am-panel" role="tabpanel" id={`am-${id}-p-medium`} aria-labelledby={`am-${id}-t-medium`} tabindex="0" data-panel="medium">
        <h5 class="am-h">2 minutes</h5>
        <slot name="medium" />
      </div>
    )}
    {Astro.slots.has('deep') && (
      <div class="am-panel" role="tabpanel" id={`am-${id}-p-deep`} aria-labelledby={`am-${id}-t-deep`} tabindex="0" data-panel="deep">
        <h5 class="am-h">Detailed</h5>
        <slot name="deep" />
      </div>
    )}
  </div>
</section>

<style>
  .am { border: 1px solid var(--accent-dim); border-radius: var(--radius); background: var(--bg-raised); padding: .9rem 1.1rem; margin: 1.6rem 0; }
  .am-q { margin: 0 0 .6rem; font-weight: 600; }
  .am-tag { display: block; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-bottom: .15rem; }
  .am-controls { display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; align-items: center; margin-bottom: .6rem; }
  .am-controls[hidden], .am-tabs[hidden], .am-body[hidden], .am-panel[hidden] { display: none; }
  .am-self { display: flex; gap: .45rem; align-items: center; font-size: .88rem; color: var(--text-dim); cursor: pointer; }
  .am button { background: transparent; color: var(--text); border: 1px solid var(--accent-dim); border-radius: 7px; padding: .45rem .9rem; font: inherit; font-size: .88rem; cursor: pointer; }
  .am button:hover { background: var(--bg-hover); }
  .am button:focus-visible, .am input:focus-visible, .am-panel:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .am-tabs { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .6rem; }
  .am-tabs button[aria-selected="true"] { border-color: var(--accent); color: var(--accent); font-weight: 700; }
  .am-panel { border-left: 3px solid var(--accent-dim); padding-left: .9rem; margin: .5rem 0; }
  .am-h { margin: .3rem 0; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--text-dim); }
  .am.am-js .am-h { display: none; }
  @media (max-width: 480px) { .am { padding: .8rem; } .am-tabs button { flex: 1 1 auto; } }
</style>

<script>
  import { getJSON, setJSON } from '../lib/learn-store.ts';

  document.querySelectorAll<HTMLElement>('[data-am]').forEach((el) => {
    const key = `citadel-answer-v1:${location.pathname}:${el.dataset.id}`;
    const saved = getJSON<{ self?: boolean; tab?: string }>(key) ?? {};
    const q = <T extends HTMLElement>(s: string) => el.querySelector<T>(s)!;
    const tabs = [...el.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...el.querySelectorAll<HTMLElement>('[data-panel]')];
    const self = q<HTMLInputElement>('[data-self]');
    const show = q<HTMLButtonElement>('[data-show]');
    const body = q('[data-body]');

    const select = (slot: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === slot;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => { p.hidden = p.dataset.panel !== slot; });
      saved.tab = slot; setJSON(key, saved);
    };

    el.classList.add('am-js');
    q('[data-controls]').hidden = false;
    q('[data-tabs]').hidden = false;
    body.hidden = true;
    self.checked = !!saved.self;
    select(tabs.some((t) => t.dataset.tab === saved.tab) ? saved.tab! : tabs[0].dataset.tab!);
    self.addEventListener('change', () => { saved.self = self.checked; setJSON(key, saved); });
    show.addEventListener('click', () => {
      const open = body.hidden;
      body.hidden = !open;
      show.setAttribute('aria-expanded', String(open));
      show.textContent = open ? 'Hide model answer' : 'Show model answer';
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const to = e.key === 'ArrowRight' ? (i + 1) % tabs.length : e.key === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length
          : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (to < 0) return;
        e.preventDefault();
        select(tabs[to].dataset.tab!, true);
      });
    });
  });
</script>
