---
// SVG array illustration: cells, pointer arrows, and labelled regions. Static, crisp, theme-matched.
// Usage:
// <ArrayStrip values={[1,0,3,0,12]} pointers={[{ at: 1, label: 'write' }, { at: 3, label: 'read', tone: 'blue' }]}
//   regions={[{ from: 0, to: 0, label: 'kept', tone: 'done' }, { from: 1, to: 2, label: 'zeros', tone: 'out' }]} />
// `join="→"` draws arrows between cells (linked lists). `tones={{ 2: 'hot' }}` tints single cells.
type Tone = 'gold' | 'blue' | 'green' | 'purple' | 'red' | 'dim';
type CellTone = 'hot' | 'done' | 'out' | 'ghost' | 'blue' | 'purple';
interface Pointer { at: number; label: string; tone?: Tone }
interface Region { from: number; to: number; label?: string; tone?: Tone }
interface Props {
  values: (string | number)[];
  pointers?: Pointer[];
  regions?: Region[];
  tones?: Record<number, CellTone>;
  indices?: boolean;
  join?: string;
  name?: string;
}
const { values, pointers = [], regions = [], tones = {}, indices = true, join, name } = Astro.props;
const W = Math.max(44, ...values.map(v => String(v).length * 11 + 18)), H = 44, GAP = join ? 26 : 8, PAD = 12;
const nameW = name ? name.length * 7.2 + 16 : 0;
const x = (i: number) => PAD + nameW + i * (W + GAP);
const byIndex = new Map<number, Pointer[]>();
pointers.forEach(p => byIndex.set(p.at, [...(byIndex.get(p.at) || []), p]));
const top = pointers.length ? 46 : 8;
const cellBottom = top + H;
const idxY = cellBottom + 15;
const regionY = (indices ? idxY : cellBottom) + 8;
const height = regionY + (regions.length ? 34 : 4);
const uid = `strip-${Math.random().toString(36).slice(2, 8)}`;
const width = PAD * 2 + nameW + Math.max(1, values.length) * (W + GAP) - GAP;
---
<svg class="strip" viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={`${name ? name + ': ' : ''}[${values.join(', ')}]`}>
  <defs>
    <marker id={uid} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="arrowhead" /></marker>
  </defs>
  {name && <text x={PAD} y={top + H / 2 + 4} class="name">{name}</text>}
  {values.length === 0 && <text x={PAD + nameW} y={top + H / 2 + 4} class="name">empty</text>}
  {regions.map(r => (
    <g class={`region t-${r.tone || 'gold'}`}>
      <rect x={x(r.from)} y={regionY} width={x(r.to) + W - x(r.from)} height={5} rx={2.5} />
      {r.label && <text x={(x(r.from) + x(r.to) + W) / 2} y={regionY + 22} text-anchor="middle">{r.label}</text>}
    </g>
  ))}
  {values.map((value, i) => (
    <g class={`cell c-${tones[i] || 'plain'}`}>
      <rect x={x(i)} y={top} width={W} height={H} rx={8} />
      <text x={x(i) + W / 2} y={top + H / 2 + 6} text-anchor="middle" class="value">{String(value)}</text>
      {indices && <text x={x(i) + W / 2} y={idxY} text-anchor="middle" class="idx">{i}</text>}
      {join && i < values.length - 1 && <line x1={x(i) + W + 3} y1={top + H / 2} x2={x(i) + W + GAP - 3} y2={top + H / 2} class="join" marker-end={`url(#${uid})`} />}
    </g>
  ))}
  {[...byIndex.entries()].map(([at, list]) => (
    <g class={`ptr t-${list[0].tone || 'gold'}`}>
      <text x={x(at) + W / 2} y={14} text-anchor="middle">{list.map(p => p.label).join(' · ')}</text>
      <line x1={x(at) + W / 2} y1={20} x2={x(at) + W / 2} y2={top - 9} />
      <path d={`M${x(at) + W / 2 - 5} ${top - 10} L${x(at) + W / 2 + 5} ${top - 10} L${x(at) + W / 2} ${top - 3} z`} class="head" />
    </g>
  ))}
</svg>
<style>
  .strip { display: block; margin: 0 auto; overflow: visible; font-family: var(--mono); }
  .cell rect { fill: #0f141b; stroke: #39414c; stroke-width: 1.2; }
  .value { fill: var(--text); font-size: 16px; font-weight: 600; }
  .idx, .name { fill: var(--text-dim); font-size: 11px; }
  .c-hot rect { fill: #3a2f12; stroke: var(--accent); }
  .c-done rect { fill: #13301c; stroke: #3fb95088; }
  .c-out rect { fill: #0d1117; stroke: #2a3038; stroke-dasharray: 4 3; }
  .c-out .value { fill: #5c6570; }
  .c-ghost rect { fill: none; stroke: #4b5563; stroke-dasharray: 5 4; }
  .c-blue rect { fill: #12253a; stroke: var(--blue); }
  .c-purple rect { fill: #261c38; stroke: var(--purple); }
  .join { stroke: var(--text-dim); stroke-width: 1.5; }
  .arrowhead { fill: var(--text-dim); }
  .ptr text { font-size: 11.5px; font-weight: 700; letter-spacing: .04em; }
  .ptr line { stroke-width: 2; }
  .region rect { opacity: .9; }
  .region text { font-size: 11px; font-family: var(--font); }
  .t-gold text { fill: var(--accent); } .t-gold line, .t-gold rect { stroke: var(--accent); fill: var(--accent); }
  .t-blue text { fill: var(--blue); } .t-blue line, .t-blue rect { stroke: var(--blue); fill: var(--blue); }
  .t-green text { fill: var(--green); } .t-green line, .t-green rect { stroke: var(--green); fill: var(--green); }
  .t-purple text { fill: var(--purple); } .t-purple line, .t-purple rect { stroke: var(--purple); fill: var(--purple); }
  .t-red text { fill: var(--red); } .t-red line, .t-red rect { stroke: var(--red); fill: var(--red); }
  .t-dim text { fill: var(--text-dim); } .t-dim line, .t-dim rect { stroke: #4b5563; fill: #4b5563; }
  .ptr line { fill: none; }
  .ptr .head { stroke: none; }
  .t-gold .head { fill: var(--accent); } .t-blue .head { fill: var(--blue); } .t-green .head { fill: var(--green); } .t-purple .head { fill: var(--purple); } .t-red .head { fill: var(--red); } .t-dim .head { fill: #4b5563; }
</style>
