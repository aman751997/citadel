---
// SVG bar chart for height problems: water containers, trapped rain, histograms, temperatures.
// Usage:
// <Bars heights={[4,1,0,2,5]} water={[0,3,4,2,0]} pointers={[{ at: 0, label: 'L' }]} />   trapped rain
// <Bars heights={[2,9,4,8]} pair={[1,3]} />                                                 container between two lines
// <Bars heights={[2,1,5,6,2,3]} rect={{ from: 2, to: 3, height: 5 }} />                     histogram rectangle
// `lines` draws thin walls instead of solid bars (Container With Most Water).
type Tone = 'gold' | 'blue' | 'green' | 'purple' | 'red';
interface Props {
  heights: number[];
  water?: number[];
  pair?: [number, number];
  rect?: { from: number; to: number; height: number };
  pointers?: { at: number; label: string; tone?: Tone }[];
  tones?: Record<number, 'hot' | 'done' | 'out'>;
  lines?: boolean;
  scale?: number;
}
const { heights, water = [], pair, rect, pointers = [], tones = {}, lines = false } = Astro.props;
const BW = 34, GAP = 8, PAD = 14;
const maxH = Math.max(1, ...heights.map((h, i) => h + (water[i] || 0)));
const unit = Astro.props.scale ?? Math.min(26, 150 / maxH);
const chartH = maxH * unit;
const top = pair || rect ? 44 : 22, base = top + chartH;
const x = (i: number) => PAD + i * (BW + GAP);
const width = PAD * 2 + heights.length * (BW + GAP) - GAP;
const byIndex = new Map<number, { label: string; tone?: Tone }[]>();
pointers.forEach(p => byIndex.set(p.at, [...(byIndex.get(p.at) || []), p]));
const height = base + (pointers.length ? 44 : 22);
const pairLevel = pair ? Math.min(heights[pair[0]], heights[pair[1]]) : 0;
---
<svg class="bars" viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={`Heights [${heights.join(', ')}]`}>
  {pair && <rect class="pool" x={x(pair[0]) + BW / 2} y={base - pairLevel * unit} width={x(pair[1]) - x(pair[0])} height={pairLevel * unit} />}
  {pair && <text class="pool-label" x={(x(pair[0]) + x(pair[1])) / 2 + BW / 2} y={14} text-anchor="middle">water = min height {pairLevel} × width {pair[1] - pair[0]} = {pairLevel * (pair[1] - pair[0])}</text>}
  {rect && <rect class="hist" x={x(rect.from)} y={base - rect.height * unit} width={x(rect.to) + BW - x(rect.from)} height={rect.height * unit} />}
  {heights.map((h, i) => (
    <g class={`bar b-${tones[i] || 'plain'}`}>
      {(water[i] || 0) > 0 && <rect class="water" x={x(i)} y={base - (h + water[i]) * unit} width={BW} height={water[i] * unit} />}
      {lines
        ? <rect class="wall" x={x(i) + BW / 2 - 2} y={base - h * unit} width={4} height={h * unit} />
        : <rect class="solid" x={x(i)} y={base - h * unit} width={BW} height={Math.max(h * unit, 0)} rx={3} />}
      <text class="hlabel" x={x(i) + BW / 2} y={base - (h + (water[i] || 0)) * unit - 6} text-anchor="middle">{h}</text>
      {(water[i] || 0) > 0 && <text class="wlabel" x={x(i) + BW / 2} y={base - (h + water[i] / 2) * unit + 4} text-anchor="middle">{water[i]}</text>}
      <text class="idx" x={x(i) + BW / 2} y={base + 14} text-anchor="middle">{i}</text>
    </g>
  ))}
  <line class="ground" x1={PAD - 6} y1={base} x2={width - PAD + 6} y2={base} />
  {rect && <text class="hist-label" x={(x(rect.from) + x(rect.to) + BW) / 2} y={14} text-anchor="middle">area = height {rect.height} × width {rect.to - rect.from + 1} = {rect.height * (rect.to - rect.from + 1)}</text>}
  {[...byIndex.entries()].map(([at, list]) => (
    <g class={`ptr t-${list[0].tone || 'gold'}`}>
      <path d={`M${x(at) + BW / 2} ${base + 19} l-5 7 h10 z`} />
      <text x={x(at) + BW / 2} y={base + 38} text-anchor="middle">{list.map(p => p.label).join(' · ')}</text>
    </g>
  ))}
</svg>
<style>
  .bars { display: block; margin: 0 auto; overflow: visible; font-family: var(--mono); }
  .solid { fill: #3a4250; stroke: #56606e; stroke-width: 1; }
  .wall { fill: #8b95a3; }
  .b-hot .solid, .b-hot .wall { fill: #7a6220; stroke: var(--accent); }
  .b-done .solid { fill: #24533a; stroke: #3fb950aa; }
  .b-out .solid, .b-out .wall { opacity: .35; }
  .water { fill: #58a6ff55; stroke: #58a6ffaa; stroke-width: 1; }
  .pool { fill: #58a6ff33; stroke: #58a6ff99; stroke-dasharray: 4 3; }
  .hist { fill: #e3b34122; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 5 3; }
  .pool-label, .hist-label { fill: var(--text); font-size: 12px; font-weight: 700; }
  .hlabel { fill: var(--text-dim); font-size: 11px; }
  .wlabel { fill: #cfe5ff; font-size: 11px; font-weight: 700; }
  .idx { fill: #6b7380; font-size: 10px; }
  .ground { stroke: #56606e; stroke-width: 1.5; }
  .ptr text { font-size: 11.5px; font-weight: 700; }
  .t-gold path { fill: var(--accent); } .t-gold text { fill: var(--accent); }
  .t-blue path { fill: var(--blue); } .t-blue text { fill: var(--blue); }
  .t-green path { fill: var(--green); } .t-green text { fill: var(--green); }
  .t-purple path { fill: var(--purple); } .t-purple text { fill: var(--purple); }
  .t-red path { fill: var(--red); } .t-red text { fill: var(--red); }
</style>
