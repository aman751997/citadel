---
// End-of-chapter completion toggle, stored in localStorage (no backend). Renders nothing without JS.
// Usage in MDX: <ChapterDone id="why-cache" />   (id must be unique within the lesson)
interface Props {
  id: string;
  label?: string;
}
const { id, label } = Astro.props;
---
<div class="chapter-done" data-chapter-done data-id={id} data-label={label ?? id} id={`rv-chapter-${id}`} hidden>
  <p class="chapter-done-text" data-text>Reached the end of this chapter? Mark it complete to track your progress.</p>
  <button class="chapter-done-btn" type="button" aria-pressed="false" data-toggle>Mark chapter complete</button>
  <div class="chapter-rev" role="group" aria-label="Schedule revision for this chapter">
    <span class="chapter-rev-label">Revision:</span>
    <button type="button" data-rev="remembered">Remembered</button>
    <button type="button" data-rev="difficult">Difficult</button>
    <button type="button" data-rev="forgotten">Forgotten</button>
    <span class="chapter-rev-status" data-rev-status role="status" aria-live="polite"></span>
  </div>
</div>

<style>
  .chapter-done {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    border: 1px dashed var(--accent-dim);
    border-radius: var(--radius);
    background: var(--bg-raised);
    padding: 0.8rem 1.1rem;
    margin: 1.8rem 0;
  }
  .chapter-done[hidden] { display: none; }
  .chapter-done-text { margin: 0; flex: 1 1 14rem; font-size: 0.9rem; color: var(--text-dim); }
  .chapter-done-btn {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--accent-dim);
    border-radius: 7px;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .chapter-done-btn:hover { background: var(--bg-hover); }
  .chapter-done-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chapter-rev { flex: 1 1 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.5rem; font-size: 0.82rem; }
  .chapter-rev[hidden] { display: none; }
  .chapter-rev-label, .chapter-rev-status { color: var(--text-dim); }
  .chapter-rev button { background: transparent; color: var(--text); border: 1px solid var(--border); border-radius: 7px; padding: 0.3rem 0.7rem; font: inherit; cursor: pointer; }
  .chapter-rev button:hover { background: var(--bg-hover); }
  .chapter-rev button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chapter-done-btn[aria-pressed='true'] { border-color: var(--green); color: var(--green); background: rgba(63, 185, 80, 0.12); }
</style>

<script>
  import { chapterKey, getJSON, setJSON, remove } from '../lib/learn-store.ts';
  import { pageSpec, recordSignal, currentItem, type Rating } from '../lib/revision.ts';

  document.querySelectorAll<HTMLElement>('[data-chapter-done]').forEach((el) => {
    const key = chapterKey(location.pathname, el.dataset.id!);
    const btn = el.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const text = el.querySelector<HTMLElement>('[data-text]')!;
    const render = () => {
      const done = getJSON<boolean>(key) === true;
      btn.setAttribute('aria-pressed', String(done));
      btn.textContent = done ? '✓ Chapter complete (click to undo)' : 'Mark chapter complete';
      text.textContent = done ? 'Nice — this chapter is marked complete.' : 'Reached the end of this chapter? Mark it complete to track your progress.';
    };
    const spec = pageSpec('chapter', el.dataset.id!, el.id, el.dataset.label!);
    const revBox = el.querySelector<HTMLElement>('.chapter-rev')!;
    const revStatus = el.querySelector<HTMLElement>('[data-rev-status]')!;
    revBox.hidden = !spec;
    const paintRev = () => {
      const it = spec && currentItem(spec.id);
      const msg = it ? `Box ${it.box} of 5, ${it.dueAt <= Date.now() ? 'due now' : 'next review ' + new Date(it.dueAt).toLocaleDateString()}` : '';
      revStatus.textContent = msg;
    };
    revBox.querySelectorAll<HTMLButtonElement>('[data-rev]').forEach((b) => b.addEventListener('click', () => {
      if (spec) recordSignal(spec, b.dataset.rev as Rating);
      paintRev();
    }));
    paintRev();
    btn.addEventListener('click', () => {
      if (getJSON<boolean>(key) === true) remove(key); else setJSON(key, true);
      render();
      el.dispatchEvent(new CustomEvent('citadel:chapter-change', { detail: { key }, bubbles: true }));
    });
    document.addEventListener('citadel:progress-reset', render);
    render();
    el.hidden = false;
  });
</script>
