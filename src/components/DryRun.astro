---
// Interactive dry run: step through an algorithm, see pointers/tones, optionally predict each move first.
// Usage in MDX:  <DryRun title="Two Sum II" frames={twoSumSortedFrames([1,3,4,6,8,11], 10)} predict />
// Build frames with the generators/recorder in src/lib/dryrun.ts. Full guide: docs/DRYRUN.md
import type { Frame } from '../lib/dryrun';
import { renderFrame } from '../lib/dryrun-render';
interface Props { title: string; frames: Frame[]; predict?: boolean }
const { title, frames, predict = false } = Astro.props;
const last = frames[frames.length - 1];
const hasPredict = frames.some(f => f.predict);
---
<section class="dr" data-dryrun aria-label={`Interactive dry run: ${title}`}>
  <header><strong>{title}</strong><span class="dr-tag">Interactive dry run</span></header>
  <div class="dr-stage" data-dr-stage set:html={renderFrame(last)} />
  <div class="dr-legend" data-dr-legend aria-hidden="true" />
  <div class="dr-controls" role="group" aria-label="Dry run controls">
    <button type="button" data-dr-back>← Back</button>
    <button type="button" data-dr-next>Next step →</button>
    <button type="button" data-dr-play aria-pressed="false">▶ Play</button>
    <button type="button" data-dr-reset>Reset</button>
    <label class="dr-opt">Speed
      <select data-dr-speed><option value="2600">Slow</option><option value="1700" selected>Normal</option><option value="800">Fast</option></select>
    </label>
    {hasPredict && <label class="dr-opt"><input type="checkbox" data-dr-predict-toggle checked={predict} /> Predict mode</label>}
    <span class="dr-count" data-dr-count></span>
  </div>
  <div class="dr-predict" data-dr-predict hidden>
    <p class="dr-q" data-dr-q></p>
    <div class="dr-opts" role="group" aria-label="Answer choices" data-dr-options></div>
  </div>
  <p class="dr-feedback" data-dr-feedback role="status" aria-live="polite" aria-atomic="true" hidden></p>
  <p class="dr-caption" data-dr-caption role="status" aria-live="polite" aria-atomic="true"></p>
  <noscript>
    <p class="dr-fallback">JavaScript is off, so the stepper is disabled. The picture above is the <strong>final state</strong>; here is every step in order:</p>
    <ol class="dr-steps">{frames.map(f => <li>{f.caption}</li>)}</ol>
  </noscript>
  <script type="application/json" data-dr-data set:html={JSON.stringify({ frames, predict }).replace(/</g, '\\u003c')} />
</section>

<script>
  import { start, forward, back, isCorrect, reveal, type Frame, type PlayerState } from '../lib/dryrun';
  import { renderFrame, renderLegend, esc } from '../lib/dryrun-render';

  function mount(root: HTMLElement) {
    const { frames, predict }: { frames: Frame[]; predict: boolean } = JSON.parse(root.querySelector('[data-dr-data]')!.textContent!);
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const [stage, legendEl, caption, count, feedback] = ['[data-dr-stage]', '[data-dr-legend]', '[data-dr-caption]', '[data-dr-count]', '[data-dr-feedback]'].map(s => q(s));
    const [btnBack, btnNext, btnPlay, btnReset] = ['[data-dr-back]', '[data-dr-next]', '[data-dr-play]', '[data-dr-reset]'].map(s => q<HTMLButtonElement>(s));
    const speed = q<HTMLSelectElement>('[data-dr-speed]');
    const toggle = root.querySelector<HTMLInputElement>('[data-dr-predict-toggle]');
    const panel = q('[data-dr-predict]'), question = q('[data-dr-q]'), options = q('[data-dr-options]');
    let s: PlayerState = start;
    let timer: number | undefined;
    const predictMode = () => !!toggle?.checked;

    const stop = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined; } btnPlay.setAttribute('aria-pressed', 'false'); btnPlay.textContent = '▶ Play'; };
    const say = (html: string) => { feedback.hidden = !html; feedback.innerHTML = html; };

    function render(focus?: 'option' | 'next') {
      const f = frames[s.i];
      stage.innerHTML = renderFrame(f);
      legendEl.innerHTML = renderLegend(f);
      caption.textContent = f.caption;
      count.textContent = `Step ${s.i + 1} of ${frames.length}`;
      btnBack.disabled = s.i === 0 && !s.pending;
      btnNext.disabled = s.i === frames.length - 1 && !s.pending;
      btnNext.textContent = s.pending ? 'Skip question →' : 'Next step →';
      panel.hidden = !s.pending;
      if (s.pending) {
        const p = frames[s.i + 1].predict!;
        stop();
        say('');
        question.textContent = `Predict the next step. ${p.question}`;
        options.innerHTML = p.options.map((o, k) => `<button type="button" data-opt="${k}">${esc(o)}</button>`).join('');
        if (focus === 'option') options.querySelector<HTMLButtonElement>('button')?.focus();
      }
      if (s.i === frames.length - 1) stop();
      if (focus === 'next') btnNext.focus();
    }

    const go = (next: PlayerState, focus?: 'option' | 'next') => { s = next; render(focus); };
    btnNext.addEventListener('click', () => { stop(); say(''); go(forward(s, frames, predictMode()), 'option'); });
    btnBack.addEventListener('click', () => { stop(); say(''); go(back(s)); });
    btnReset.addEventListener('click', () => { stop(); say(''); go(start); });
    toggle?.addEventListener('change', () => { if (!predictMode() && s.pending) { say(''); go(back(s)); } });
    const tick = () => { go(forward(s, frames, predictMode())); if (s.pending || s.i === frames.length - 1) stop(); };
    const run = () => { clearInterval(timer); timer = window.setInterval(tick, +speed.value); };
    btnPlay.addEventListener('click', () => {
      if (timer !== undefined) return stop();
      say('');
      if (s.i === frames.length - 1) go(start);
      btnPlay.setAttribute('aria-pressed', 'true');
      btnPlay.textContent = '⏸ Pause';
      run();
      tick();
    });
    speed.addEventListener('change', () => { if (timer !== undefined) run(); });
    options.addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-opt]');
      if (!b || !s.pending) return;
      const p = frames[s.i + 1].predict!;
      const choice = +b.dataset.opt!;
      if (isCorrect(p, choice)) {
        s = reveal(s);
        render('next');
        say(`<strong>✓ Correct.</strong> ${esc(p.explain)}`);
      } else {
        b.disabled = true;
        b.textContent = `✗ ${p.options[choice]}`;
        b.classList.add('wrong');
        say('<strong>✗ Not quite.</strong> Look at the picture again and try another option.');
      }
    });
    root.dataset.ready = '';
    render();
  }
  document.querySelectorAll<HTMLElement>('[data-dryrun]').forEach(mount);
</script>

<style is:global>
  .dr { border: 1px solid var(--accent-dim); border-radius: 12px; background: var(--bg-raised); padding: 1rem 1.1rem; margin: 1.6rem 0; }
  .dr > header { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; flex-wrap: wrap; margin-bottom: .7rem; }
  .dr > header strong { color: var(--accent); }
  .dr-tag { font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); font-weight: 700; }
  .dr-stage { display: flex; flex-direction: column; gap: .7rem; min-width: 0; }
  .dr-view { margin: 0; min-width: 0; }
  .dr-name { font-size: .72rem; color: var(--text-dim); font-family: var(--mono); margin-bottom: .2rem; }
  .dr-scroll { overflow-x: auto; padding: .2rem 0; }
  .dr-row { display: flex; align-items: flex-start; gap: .3rem; width: max-content; margin: 0 auto; }
  .dr-col { display: flex; flex-direction: column; align-items: center; min-width: 2.6rem; }
  .dr-ptr { font-size: .68rem; font-weight: 700; font-family: var(--mono); white-space: nowrap; min-height: 1.1rem; }
  .dr-ptr:not(:empty)::after { content: "\25BC"; display: block; text-align: center; font-size: .6rem; line-height: .7; }
  .dr-cell { display: block; min-width: 2.6rem; text-align: center; padding: .4rem .35rem; border: 1px solid #39414c; border-radius: 8px; background: #0f141b; font-family: var(--mono); font-weight: 600; transition: background .2s, border-color .2s; position: relative; }
  .dr-idx { font-size: .68rem; color: var(--text-dim); font-family: var(--mono); }
  .dr-reg { display: block; height: 5px; width: 100%; border-radius: 3px; margin-top: 2px; background: transparent; }
  .dr-reg.on { background: currentColor; opacity: .85; }
  .dr-reglbl { font-size: .66rem; white-space: nowrap; min-height: .9rem; align-self: flex-start; }
  .dr-join { align-self: center; margin-top: 1.1rem; color: var(--text-dim); font-family: var(--mono); }
  .dr-empty { color: var(--text-dim); font-size: .85rem; }
  .dr-mark { position: absolute; top: -.45rem; right: -.35rem; background: var(--green); color: #04140a; border-radius: 50%; width: .95rem; height: .95rem; line-height: .95rem; font-size: .65rem; }
  .t-gold { color: var(--accent); } .t-blue { color: var(--blue); } .t-green { color: var(--green); } .t-purple { color: var(--purple); } .t-red { color: var(--red); } .t-dim { color: var(--text-dim); }
  .dr .tone-active { background: #3a2f12; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .dr .tone-compared { background: #12253a; border-color: var(--blue); border-style: dashed; }
  .dr .tone-swapped { background: #261c38; border-color: var(--purple); }
  .dr .tone-visited { background: #1a2433; border-color: #5b7fb0; }
  .dr .tone-done { background: #13301c; border-color: #3fb95088; }
  .dr .tone-out { background: #0d1117; border: 1px dashed #2a3038; color: #6b7480; opacity: .6; }
  .dr .tone-found { background: #1d4a2a; border-color: var(--green); box-shadow: 0 0 0 1px var(--green); }
  .dr-table { border-collapse: separate; border-spacing: 3px; margin: 0 auto; font-family: var(--mono); font-size: .8rem; }
  .dr-table th { color: var(--text-dim); font-weight: 500; font-size: .7rem; padding: 0 .4rem; text-align: center; white-space: nowrap; }
  .dr-table th[scope="row"] { text-align: right; }
  .dr-table td.dr-cell { display: table-cell; position: relative; min-width: 2.2rem; padding: .35rem .3rem; }
  .dr-table td.blank { color: var(--text-dim); }
  .dr-gptr { position: absolute; left: 0; right: 0; bottom: -.1rem; font-size: .55rem; font-weight: 700; }
  .dr-chips { list-style: none; margin: 0; padding: .4rem; display: flex; gap: .35rem; flex-wrap: wrap; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); min-height: 2.4rem; align-items: center; }
  .dr-stack .dr-chips { flex-direction: column; align-items: stretch; flex-wrap: nowrap; max-width: 12rem; }
  .dr-chip { font-family: var(--mono); font-size: .85rem; padding: .25rem .6rem; border: 1px solid #39414c; border-radius: 6px; background: #0f141b; text-align: center; }
  .dr-chip small { display: block; font-size: .6rem; color: var(--text-dim); }
  .dr-chip.edge { border-color: var(--blue); } .dr-chip.edge small { color: var(--blue); }
  .dr-chip.just { border-color: var(--green); background: #13301c; } .dr-chip small.new { color: var(--green); }
  .dr-chip.gone { border-style: dashed; opacity: .6; text-decoration: line-through; } .dr-chip.gone small { text-decoration: none; color: var(--red); }
  .dr-chip.empty { border-style: dashed; color: var(--text-dim); }
  .dr-note { font-size: .78rem; color: var(--text-dim); margin: .2rem 0 0; }
  .dr-svg { display: block; margin: 0 auto; height: auto; overflow: visible; font-family: var(--mono); }
  .dr-node circle, .dr-node rect { fill: #0f141b; stroke: #39414c; stroke-width: 1.5; }
  .dr-node text { fill: var(--text); font-size: 12px; font-weight: 600; }
  .dr-node.tone-current circle { fill: #3a2f12; stroke: var(--accent); stroke-width: 2.5; }
  .dr-node.tone-visited circle { fill: #1a2433; stroke: #5b7fb0; }
  .dr-node.tone-queued circle { fill: #12253a; stroke: var(--blue); stroke-dasharray: 4 3; }
  .dr-node.tone-done circle { fill: #13301c; stroke: var(--green); }
  .dr-node.onpath circle { stroke: var(--accent); stroke-width: 2.5; }
  .dr-node.rec.tone-exploring rect { fill: #3a2f12; stroke: var(--accent); }
  .dr-node.rec.tone-pruned rect { fill: #3a1616; stroke: var(--red); stroke-dasharray: 4 3; }
  .dr-node.rec.tone-solution rect { fill: #1d4a2a; stroke: var(--green); stroke-width: 2.5; }
  .dr-node.rec.tone-undone rect { fill: none; stroke: #4b5563; stroke-dasharray: 4 3; }
  .dr-node.rec.tone-undone text { fill: #6b7480; text-decoration: line-through; }
  .dr-edge line { stroke: #4b5563; stroke-width: 1.5; }
  line.dr-edge { stroke: #4b5563; stroke-width: 1.5; } line.dr-edge.path { stroke: var(--accent); stroke-width: 2.5; }
  .dr-edge.e-active line { stroke: var(--accent); stroke-width: 3; } .dr-edge.e-used line { stroke: var(--green); stroke-width: 2.5; } .dr-edge.e-dim line { stroke-dasharray: 3 3; opacity: .6; }
  .dr-w { fill: var(--text-dim); font-size: 10px; } .dr-arrowhead { fill: #8b949e; }
  .dr-vars { border-collapse: collapse; font-family: var(--mono); font-size: .8rem; }
  .dr-vars th { text-align: left; color: var(--text-dim); font-weight: 500; padding: .1rem .8rem .1rem 0; }
  .dr-vars tr.chg td { color: var(--accent); font-weight: 700; }
  .dr-flag { font-size: .6rem; text-transform: uppercase; letter-spacing: .06em; border: 1px solid var(--accent); border-radius: 4px; padding: 0 .25rem; }
  .dr-legend { display: flex; flex-wrap: wrap; gap: .3rem .8rem; margin-top: .6rem; font-size: .7rem; color: var(--text-dim); min-height: 1rem; }
  .dr-key .sw { display: inline-block; width: .7rem; height: .7rem; border-radius: 3px; margin-right: .3rem; vertical-align: -1px; border: 1px solid #39414c; }
  .dr-key .sw.tone-current, .dr-key .sw.tone-exploring { background: #3a2f12; border-color: var(--accent); }
  .dr-key .sw.tone-queued { background: #12253a; border: 1px dashed var(--blue); }
  .dr-key .sw.tone-pruned { background: #3a1616; border: 1px dashed var(--red); }
  .dr-key .sw.tone-solution { background: #1d4a2a; border-color: var(--green); }
  .dr-key .sw.tone-undone { background: none; border: 1px dashed #4b5563; }
  .dr-controls { display: none; flex-wrap: wrap; gap: .5rem; align-items: center; margin-top: .8rem; }
  .dr[data-ready] .dr-controls { display: flex; }
  .dr button { background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 7px; padding: .5rem .8rem; font: inherit; font-size: .85rem; cursor: pointer; }
  .dr button:hover:not(:disabled) { border-color: var(--accent); }
  .dr button:focus-visible, .dr select:focus-visible, .dr input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dr button:disabled { opacity: .45; cursor: default; }
  .dr button[aria-pressed="true"] { border-color: var(--green); color: var(--green); }
  .dr-opt { font-size: .8rem; color: var(--text-dim); display: flex; align-items: center; gap: .35rem; }
  .dr select { background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: .25rem; font: inherit; }
  .dr-count { margin-left: auto; font-family: var(--mono); font-size: .8rem; color: var(--text-dim); }
  .dr-predict { border: 1px solid var(--blue); border-radius: 10px; padding: .7rem .8rem; margin-top: .8rem; background: #12253a40; }
  .dr-q { margin: 0 0 .5rem; font-weight: 600; }
  .dr-opts { display: flex; flex-direction: column; gap: .4rem; align-items: stretch; }
  .dr-opts button { text-align: left; }
  .dr-opts button.wrong { border-color: var(--red); color: var(--red); }
  .dr-feedback { border-left: 3px solid var(--green); padding-left: .8rem; margin: .8rem 0 0; }
  .dr-caption { border-left: 3px solid var(--accent); padding-left: .8rem; margin: .8rem 0 0; min-height: 3.2em; }
  .dr-fallback { border-left: 3px solid var(--accent); padding-left: .8rem; color: var(--text-dim); }
  @media (max-width: 480px) { .dr { padding: .8rem; } .dr-controls button { flex: 1 1 auto; } .dr-count { margin-left: 0; width: 100%; } .dr-col, .dr-cell { min-width: 2.2rem; } }
  @media (prefers-reduced-motion: reduce) { .dr * { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
</style>
