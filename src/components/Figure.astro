---
// Captioned illustration wrapper for diagrams, inline SVG, <ArrayStrip>, <Bars>, or <Mermaid>.
// Usage: <Figure caption="Everything outside the twins has already matched."> ... </Figure>
interface Props { caption?: string; label?: string }
const { caption, label = 'Figure' } = Astro.props;
---
<figure class="fig">
  <div class="fig-art"><slot /></div>
  {caption && <figcaption><span>{label}</span> {caption}</figcaption>}
</figure>
<style>
  .fig { margin: 1.6rem 0; padding: 1rem 1rem .8rem; border: 1px solid var(--border); border-radius: 12px; background: radial-gradient(circle at 20% 0%, #1d2431, var(--bg-raised) 70%); }
  .fig-art { overflow-x: auto; display: flex; flex-direction: column; align-items: stretch; gap: .6rem; }
  /* A Mermaid diagram inside a figure: no second frame, full width so it can't collapse. */
  .fig-art :global(.diagram) { margin: 0; padding: 0; border: 0; background: none; }
  .fig-art :global(svg) { max-width: 100%; height: auto; }
  figcaption { margin-top: .7rem; font-size: .85rem; color: var(--text-dim); text-align: center; font-style: italic; }
  figcaption span { font-style: normal; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-right: .3rem; }
</style>
