---
// Progressive help: three hints, then the Java. Labels default to wording that fits every pattern.
interface Props { hints: [string, string, string]; labels?: [string, string, string, string]; }
const { hints, labels = ['A small nudge', 'Name the moving parts', 'The loop and its stopping rule', 'Compare with the Java solution'] } = Astro.props;
---
<div class="ladder">
  <p class="ladder-intro"><strong>Your turn to write it.</strong> Try a few lines first. Open only as much help as you need.</p>
  <details>
    <summary>1 · {labels[0]}</summary><p>{hints[0]}</p>
    <details>
      <summary>2 · {labels[1]}</summary><p>{hints[1]}</p>
      <details>
        <summary>3 · {labels[2]}</summary><p>{hints[2]}</p>
        <details class="solution"><summary>4 · {labels[3]}</summary><slot /></details>
      </details>
    </details>
  </details>
</div>
<style>
  .ladder { border:1px solid var(--border); border-radius:10px; padding:1rem; margin:1.4rem 0; background:var(--bg-raised); }
  .ladder-intro { margin:0 0 .6rem; font-size:.9rem; color:var(--text-dim); }
  .ladder-intro strong { color:var(--text); }
  details { border-top:1px solid var(--border); margin-top:.6rem; }
  summary { cursor:pointer; padding:.7rem 0; font-weight:600; color:var(--accent); }
  summary:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  details p { border-left:2px solid var(--blue); padding-left:.8rem; }
  .solution summary { color:var(--green); }
</style>
