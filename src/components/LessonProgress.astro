---
// Lesson-level progress summary: chapters done (from <ChapterDone>) and best quiz scores (from <Quiz>). Place once near the top.
// Renders nothing without JS.
---
<aside class="lesson-progress" data-lesson-progress aria-label="Lesson progress" hidden>
  <p class="lp-line"><strong data-lp-chapters></strong> <span data-lp-quizzes></span></p>
  <div class="lp-bar" role="progressbar" aria-label="Chapters done" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-lp-bar><span data-lp-fill></span></div>
  <button class="lp-reset" type="button" data-lp-reset>Reset progress</button>
</aside>

<style>
  .lesson-progress {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    padding: 0.7rem 1.1rem;
    margin: 1.2rem 0;
    font-size: 0.88rem;
  }
  .lesson-progress[hidden] { display: none; }
  .lp-line { margin: 0 0 0.5rem; display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; color: var(--text-dim); }
  .lp-line strong { color: var(--text); }
  .lp-bar { height: 6px; border-radius: 999px; background: var(--bg); border: 1px solid var(--border); overflow: hidden; }
  .lp-bar span { display: block; height: 100%; width: 0; background: var(--green); transition: width 0.2s; }
  .lp-reset {
    margin-top: 0.6rem;
    background: transparent;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0.25rem 0.7rem;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .lp-reset:hover { color: var(--text); border-color: var(--accent-dim); }
  .lp-reset:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

<script>
  import { quizKey, chapterKey, getJSON, remove, keysWithPrefix, isPassed, QUIZ_PREFIX, CHAPTER_PREFIX } from '../lib/learn-store.ts';

  const root = document.querySelector<HTMLElement>('[data-lesson-progress]');
  if (root) {
    const path = location.pathname;
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const update = () => {
      const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter-done]'));
      const done = chapters.filter((c) => getJSON<boolean>(chapterKey(path, c.dataset.id!)) === true).length;
      const quizzes = Array.from(document.querySelectorAll<HTMLElement>('[data-quiz]'));
      const passed = quizzes.filter((el, i) => {
        const state = getJSON<{ best?: number | null }>(quizKey(path, el.dataset.quizId || i));
        return isPassed(state?.best, Number(el.dataset.total));
      }).length;
      q('[data-lp-chapters]').textContent = chapters.length ? `${done} of ${chapters.length} chapters done` : '';
      q('[data-lp-quizzes]').textContent = quizzes.length ? `Quizzes: ${passed}/${quizzes.length} passed (best scores, 70%+)` : '';
      const pct = chapters.length ? Math.round((done / chapters.length) * 100) : 0;
      q('[data-lp-fill]').style.width = pct + '%';
      q('[data-lp-bar]').setAttribute('aria-valuenow', String(pct));
      q('[data-lp-bar]').hidden = !chapters.length;
      root.hidden = !chapters.length && !quizzes.length;
    };
    document.addEventListener('citadel:chapter-change', update);
    document.addEventListener('citadel:quiz-complete', update);
    document.addEventListener('citadel:progress-reset', update);
    q('[data-lp-reset]').addEventListener('click', () => {
      [QUIZ_PREFIX, CHAPTER_PREFIX].forEach((p) => keysWithPrefix(`${p}:${path}:`).forEach(remove));
      document.dispatchEvent(new CustomEvent('citadel:progress-reset'));
    });
    update();
  }
</script>
