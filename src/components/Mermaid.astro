---
// Client-rendered mermaid diagram. Usage in MDX:
// <Mermaid code={`flowchart LR\n  A --> B`} />
interface Props {
  code: string;
}
const { code } = Astro.props;
---
<div class="diagram"><pre class="mermaid">{code}</pre></div>

<style>
  .diagram {
    margin: 1.4rem 0;
    padding: 0.8rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }
  .diagram :global(pre.mermaid-error) { color: var(--red); white-space: pre-wrap; font-size: .8rem; }
  .diagram :global(pre.mermaid svg) { display: block; margin: 0 auto; }
  .diagram :global(pre.mermaid) {
    width: 100%;
    background: none !important;
    border: none;
    padding: 0;
    margin: 0;
  }
</style>

<script>
  import mermaid from 'mermaid';
  mermaid.initialize({
    startOnLoad: false,
    theme: 'dark',
    themeVariables: {
      darkMode: true,
      background: '#161b22',
      primaryColor: '#1c2330',
      primaryTextColor: '#e6edf3',
      primaryBorderColor: '#e3b341',
      lineColor: '#9198a1',
      fontFamily: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif',
    },
  });
  // Render one diagram at a time with our own ids: mermaid's auto-run can hand two diagrams the
  // same id on fast pages, and the second then overwrites the first.
  (async () => {
    const blocks = [...document.querySelectorAll<HTMLElement>('pre.mermaid:not([data-rendered])')];
    for (const [index, block] of blocks.entries()) {
      block.dataset.rendered = 'true';
      try {
        const { svg } = await mermaid.render(`citadel-mermaid-${index}`, block.textContent || '');
        block.innerHTML = svg;
      } catch (error) {
        block.textContent = `Diagram failed to render: ${(error as Error).message}`;
        block.classList.add('mermaid-error');
      }
    }
  })();
</script>
