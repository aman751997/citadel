---
// Timed machine-coding mock (60 or 90 minutes). Usage in MDX:
//   <MockInterview minutes={60}
//     phases={[{ name: 'Read requirements', minutes: 5, prompt: '...', hints: ['h1','h2','h3'], reveal: 'reference text' }, ...]}
//     checklist={['Classes have one responsibility', ...]} />
// Phase `minutes` are scaled to add up to `minutes`. `hints` (max 3) unlock one at a time; `reveal` stays locked until the
// learner typed notes or confirmed an attempt. `reveal` is shown as plain text with line breaks kept.
// State (timer, notes, hints, checklist): citadel-mock-v1:<pathname>:<id>. Without JS the whole script is shown as a list.
import { scaleBudgets } from '../lib/mock-interview.ts';
interface Phase { name: string; minutes: number; prompt: string; hints?: string[]; reveal?: string }
interface Props { id: string; minutes?: number; phases: Phase[]; checklist?: string[]; title?: string }
const { id, minutes = 60, phases, checklist = [], title = 'Mock interview' } = Astro.props;
const budgets = scaleBudgets(phases.map((p) => p.minutes), minutes).map((m) => Math.round(m * 10) / 10);
---
<section class="mi" data-mi data-id={id} data-minutes={minutes} data-budgets={JSON.stringify(budgets)} aria-label={title}>
  <header class="mi-head"><strong>{title}</strong><span class="mi-tag">{minutes}-minute mock</span></header>
  <div class="mi-bar" data-bar hidden>
    <output class="mi-clock" data-clock role="timer" aria-label="Time remaining">{minutes}:00</output>
    <button type="button" data-start>Start</button>
    <button type="button" data-reset>Reset timer</button>
    <span class="mi-status" data-status role="status" aria-live="polite"></span>
  </div>
  <p class="mi-progress" data-progress hidden></p>

  <ol class="mi-phases">
    {phases.map((p, i) => (
      <li class="mi-phase" data-phase data-i={i}>
        <h4>{p.name} <span class="mi-budget">{budgets[i]} min suggested</span></h4>
        <p class="mi-prompt">{p.prompt}</p>
        <div class="mi-work" data-work hidden>
          <label for={`mi-${id}-n${i}`}>Your notes for this phase</label>
          <textarea id={`mi-${id}-n${i}`} rows="6" data-notes placeholder="Classes, methods, trade-offs, code sketch..."></textarea>
          <label class="mi-attempt"><input type="checkbox" data-attempt /> I attempted this on paper or in my editor</label>
          <div class="mi-actions">
            {p.hints?.length ? <button type="button" data-hint>Hint</button> : null}
            {p.reveal ? <button type="button" data-reveal-btn aria-describedby={`mi-${id}-lock${i}`}>Reveal the reference for this phase</button> : null}
          </div>
          {p.reveal ? <p class="mi-lock" id={`mi-${id}-lock${i}`} data-lock>Locked: write something in your notes or tick the attempt box first.</p> : null}
        </div>
        {p.hints?.length ? (
          <ol class="mi-hints" aria-label="Hints">
            {p.hints.slice(0, 3).map((h) => (<li data-hintitem>{h}</li>))}
          </ol>
        ) : null}
        {p.reveal ? (<div class="mi-reveal" data-reveal><strong>Reference</strong><div class="mi-reveal-text">{p.reveal}</div></div>) : null}
      </li>
    ))}
  </ol>

  <div class="mi-nav" data-nav hidden>
    <button type="button" data-prev>Previous phase</button>
    <button type="button" data-next>Next phase</button>
  </div>

  <div class="mi-final" data-final>
    <h4>Self-assessment</h4>
    <ul class="mi-checks">
      {checklist.map((c, i) => (
        <li><label><input type="checkbox" data-check data-i={i} /> {c}</label></li>
      ))}
    </ul>
    <p class="mi-score" data-score role="status" aria-live="polite"></p>
    <button type="button" data-restart hidden>Start over (clears notes)</button>
  </div>
</section>

<style>
  .mi { border: 1px solid var(--green); border-radius: var(--radius); background: var(--bg-raised); padding: .9rem 1.1rem; margin: 1.8rem 0; }
  .mi-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem; align-items: baseline; margin-bottom: .6rem; }
  .mi-head strong { color: var(--green); }
  .mi-tag { font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); font-weight: 700; }
  .mi-bar { display: flex; flex-wrap: wrap; gap: .5rem .8rem; align-items: center; padding: .5rem 0; position: sticky; top: 0; background: var(--bg-raised); z-index: 1; }
  .mi-clock { font-family: var(--mono); font-size: 1.6rem; font-weight: 700; min-width: 5ch; }
  .mi-clock.over { color: var(--red); }
  .mi-status { font-size: .85rem; color: var(--text-dim); }
  .mi-progress { margin: .2rem 0 .6rem; font-size: .88rem; color: var(--text-dim); font-family: var(--mono); }
  .mi-progress.over { color: var(--accent); }
  .mi-phases { padding-left: 1.2rem; margin: .4rem 0; }
  .mi-phase h4 { margin: .8rem 0 .2rem; }
  .mi-budget { font-family: var(--mono); font-size: .72rem; color: var(--text-dim); font-weight: 400; margin-left: .4rem; }
  .mi-prompt { margin: .2rem 0 .6rem; }
  .mi-work label { display: block; font-size: .85rem; color: var(--text-dim); margin-bottom: .25rem; }
  .mi-work textarea { width: 100%; box-sizing: border-box; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 7px; padding: .6rem; font-family: var(--mono); font-size: .85rem; resize: vertical; }
  .mi-work .mi-attempt { display: flex; gap: .45rem; align-items: center; margin-top: .4rem; cursor: pointer; }
  .mi-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
  .mi-lock { font-size: .8rem; color: var(--text-dim); margin: .4rem 0 0; }
  .mi-hints { margin: .6rem 0 0; padding-left: 1.2rem; color: var(--text-dim); font-size: .92rem; }
  .mi-hints li { margin: .2rem 0; }
  .mi-reveal { border-left: 3px solid var(--green); padding-left: .9rem; margin: .8rem 0; }
  .mi-reveal-text { white-space: pre-wrap; margin-top: .2rem; }
  .mi-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin: .8rem 0; }
  .mi-final { border-top: 1px dashed var(--border); margin-top: .8rem; padding-top: .4rem; }
  .mi-checks { list-style: none; padding: 0; }
  .mi-checks label { display: flex; gap: .5rem; align-items: baseline; cursor: pointer; }
  .mi-score { font-family: var(--mono); font-weight: 700; }
  .mi button { background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 7px; padding: .45rem .9rem; font: inherit; font-size: .88rem; cursor: pointer; }
  .mi button:hover:not(:disabled) { border-color: var(--green); }
  .mi button:disabled { opacity: .45; cursor: default; }
  .mi button:focus-visible, .mi textarea:focus-visible, .mi input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mi [hidden] { display: none !important; }
  .mi:not(.mi-js) .mi-final .mi-score { display: none; }
  /* JS mode: one phase at a time, hints and references revealed on demand */
  .mi-js .mi-phase:not(.current) { display: none; }
  .mi-js .mi-phases { list-style: none; padding-left: 0; }
  .mi-js .mi-hints li:not(.shown) { display: none; }
  .mi-js .mi-hints:not(.any) { display: none; }
  .mi-js .mi-reveal:not(.open) { display: none; }
  .mi-js .mi-final:not(.open) { display: none; }
  @media (max-width: 480px) { .mi { padding: .8rem; } .mi-bar button, .mi-nav button, .mi-actions button { flex: 1 1 auto; } }
</style>

<script>
  import { getJSON, setJSON, remove } from '../lib/learn-store.ts';
  import { startTimer, pauseTimer, newTimer, isRunning, elapsedMs, remainingMs, formatClock, phaseClock, nextHintCount,
    canReveal, scoreChecklist, normalizeSession, newSession, type Session } from '../lib/mock-interview.ts';

  document.querySelectorAll<HTMLElement>('[data-mi]').forEach((el) => {
    const key = `citadel-mock-v1:${location.pathname}:${el.dataset.id}`;
    const totalMin = Number(el.dataset.minutes) || 60;
    const budgets: number[] = JSON.parse(el.dataset.budgets!);
    const phases = [...el.querySelectorAll<HTMLElement>('[data-phase]')];
    const checks = [...el.querySelectorAll<HTMLInputElement>('[data-check]')];
    let s: Session = normalizeSession(getJSON(key), phases.length, checks.length);
    const q = <T extends HTMLElement>(sel: string) => el.querySelector<T>(sel)!;
    const clock = q('[data-clock]'), status = q('[data-status]'), progress = q('[data-progress]');
    const startBtn = q<HTMLButtonElement>('[data-start]');
    const save = () => setJSON(key, s);
    let tick = 0, announcedEnd = false;

    const paintClock = () => {
      const now = Date.now();
      const left = remainingMs(s.timer, now, totalMin);
      clock.textContent = formatClock(left);
      clock.classList.toggle('over', left === 0);
      if (left === 0 && isRunning(s.timer) && !announcedEnd) { announcedEnd = true; status.textContent = 'Time is up. Wrap up and self-assess.'; }
      if (!s.finished) {
        const pc = phaseClock(budgets[s.phase], elapsedMs(s.timer, now) - s.phaseStarts[s.phase]);
        progress.textContent = `Phase ${s.phase + 1} of ${phases.length}: ${pc.over ? 'over budget by' : 'left in budget'} ${formatClock(pc.ms)}`;
        progress.classList.toggle('over', pc.over);
      }
    };
    const setTick = () => {
      clearInterval(tick);
      if (isRunning(s.timer)) tick = window.setInterval(paintClock, 1000);
      startBtn.textContent = isRunning(s.timer) ? 'Pause' : elapsedMs(s.timer, Date.now()) > 0 ? 'Resume' : 'Start';
      paintClock();
    };

    const paintPhase = (i: number) => {
      const p = phases[i];
      const notes = p.querySelector<HTMLTextAreaElement>('[data-notes]')!;
      const attempt = p.querySelector<HTMLInputElement>('[data-attempt]')!;
      const hintItems = [...p.querySelectorAll<HTMLElement>('[data-hintitem]')];
      const hintBtn = p.querySelector<HTMLButtonElement>('[data-hint]');
      const revBtn = p.querySelector<HTMLButtonElement>('[data-reveal-btn]');
      hintItems.forEach((h, n) => h.classList.toggle('shown', n < s.hints[i]));
      p.querySelector('.mi-hints')?.classList.toggle('any', s.hints[i] > 0);
      if (hintBtn) {
        hintBtn.disabled = s.hints[i] >= hintItems.length;
        hintBtn.textContent = hintBtn.disabled ? `All ${hintItems.length} hints shown` : `Hint (${s.hints[i] + 1} of ${hintItems.length})`;
      }
      if (revBtn) {
        const ok = canReveal(s.notes[i], s.attempted[i]);
        revBtn.disabled = !ok || s.revealed[i];
        revBtn.textContent = s.revealed[i] ? 'Reference shown below' : 'Reveal the reference for this phase';
        p.querySelector<HTMLElement>('[data-lock]')!.hidden = ok;
        p.querySelector('[data-reveal]')?.classList.toggle('open', s.revealed[i]);
      }
      notes.value = s.notes[i];
      attempt.checked = s.attempted[i];
    };

    const paintScore = () => {
      const r = scoreChecklist(s.checks);
      q('[data-score]').textContent = r.total ? `Score: ${r.done} / ${r.total} (${r.pct}%)` : '';
    };

    const paintView = () => {
      phases.forEach((p, i) => p.classList.toggle('current', !s.finished && i === s.phase));
      q('[data-final]').classList.toggle('open', s.finished);
      q('[data-restart]').hidden = !s.finished;
      progress.hidden = s.finished;
      q<HTMLButtonElement>('[data-prev]').disabled = s.finished ? false : s.phase === 0;
      q<HTMLButtonElement>('[data-prev]').textContent = s.finished ? 'Back to phases' : 'Previous phase';
      q<HTMLButtonElement>('[data-next]').hidden = s.finished;
      q<HTMLButtonElement>('[data-next]').textContent = s.phase === phases.length - 1 ? 'Finish and self-assess' : 'Next phase';
      paintClock();
    };

    phases.forEach((p, i) => {
      const notes = p.querySelector<HTMLTextAreaElement>('[data-notes]')!;
      notes.addEventListener('input', () => { s.notes[i] = notes.value; save(); paintPhase(i); });
      p.querySelector('[data-attempt]')!.addEventListener('change', (e) => { s.attempted[i] = (e.target as HTMLInputElement).checked; save(); paintPhase(i); });
      p.querySelector('[data-hint]')?.addEventListener('click', () => {
        s.hints[i] = nextHintCount(s.hints[i], p.querySelectorAll('[data-hintitem]').length); save(); paintPhase(i);
      });
      p.querySelector('[data-reveal-btn]')?.addEventListener('click', () => { s.revealed[i] = true; save(); paintPhase(i); });
      paintPhase(i);
    });
    checks.forEach((c, i) => {
      c.checked = s.checks[i];
      c.addEventListener('change', () => { s.checks[i] = c.checked; save(); paintScore(); });
    });

    const go = (to: number) => {
      s.phase = to; s.phaseStarts[to] = elapsedMs(s.timer, Date.now());
      save(); paintView();
    };
    q('[data-next]').addEventListener('click', () => {
      if (s.phase === phases.length - 1) { s.finished = true; s.timer = pauseTimer(s.timer, Date.now()); save(); setTick(); paintView(); paintScore(); q('[data-final]').scrollIntoView({ block: 'nearest' }); }
      else go(s.phase + 1);
    });
    q('[data-prev]').addEventListener('click', () => {
      if (s.finished) { s.finished = false; save(); paintView(); } else if (s.phase > 0) go(s.phase - 1);
    });
    startBtn.addEventListener('click', () => {
      s.timer = isRunning(s.timer) ? pauseTimer(s.timer, Date.now()) : startTimer(s.timer, Date.now());
      announcedEnd = false;
      status.textContent = isRunning(s.timer) ? 'Timer running.' : 'Timer paused.';
      save(); setTick();
    });
    q('[data-reset]').addEventListener('click', () => {
      s.timer = newTimer(); s.phaseStarts.fill(0); announcedEnd = false; status.textContent = 'Timer reset.'; save(); setTick(); paintView();
    });
    q('[data-restart]').addEventListener('click', () => {
      s = newSession(phases.length, checks.length); remove(key); announcedEnd = false;
      status.textContent = 'Session cleared.';
      phases.forEach((_, i) => paintPhase(i)); checks.forEach((c) => (c.checked = false));
      setTick(); paintView(); paintScore();
    });

    el.classList.add('mi-js');
    q('[data-bar]').hidden = false;
    q('[data-nav]').hidden = false;
    el.querySelectorAll<HTMLElement>('[data-work]').forEach((w) => (w.hidden = false));
    setTick(); paintView(); paintScore();
  });
</script>
