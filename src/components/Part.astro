---
// Book-style part divider between groups of chapters.
// Usage: <Part n="Part One" title="The twins walk inward">Opposite ends. Prove what you can leave behind.</Part>
interface Props { n: string; title: string }
const { n, title } = Astro.props;
---
<div class="part" role="separator" aria-label={`${n}: ${title}`}>
  <span class="rule" aria-hidden="true"></span>
  <p class="n">{n}</p>
  <p class="title">{title}</p>
  <div class="blurb"><slot /></div>
  <span class="rule" aria-hidden="true"></span>
</div>
<style>
  .part { text-align: center; margin: 4rem 0 2rem; }
  .rule { display: block; width: 120px; height: 1px; margin: 0 auto; background: linear-gradient(90deg, transparent, var(--accent-dim), transparent); }
  .n { margin: 1rem 0 0; font-size: .7rem; letter-spacing: .3em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
  .title { margin: .3rem 0 .4rem; font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif; font-size: 1.9rem; font-style: italic; color: #ece3d0; }
  .blurb { color: var(--text-dim); font-size: .92rem; max-width: 34rem; margin: 0 auto 1rem; }
  .blurb :global(p) { margin: .2rem 0; }
</style>
