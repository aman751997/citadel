---
// Front matter for a pattern lesson, styled like the opening pages of a novel:
// a logline, the cast, the table of contents, and a "next 8 minutes" session card wired to spaced review.
import { practiceSets } from '../lib/registry';
interface Props {
  pattern: string;
  start: string;                                   // anchor of the first chapter
  logline: string;                                 // one-sentence premise of the story
  cast?: { name: string; role: string }[];
  parts: { name: string; description: string; links: [string, string][] }[];
  extensions?: [string, string][];                 // "change one rule" side quests
  extras?: [string, string][];                     // epilogue links
  note?: string;
  sessionMinutes?: number;
  // Override the three entry cards (SD/LLD lessons have no playground or practice set).
  routes?: { href: string; title: string; text: string }[];
}
const { pattern, start, logline, cast = [], parts, extensions = [], extras = [], note, sessionMinutes = 8 } = Astro.props;
const practice = practiceSets[pattern] ? (await practiceSets[pattern]()).practice : null;
const routes = Astro.props.routes ?? [
  { href: `#${start}`, title: '📖 Read the story', text: 'Scene → puzzle → why it works → hints → Java' },
  { href: '#playground', title: '🎮 Take the controls', text: 'Every move is yours. See what a wrong one breaks.' },
  { href: '#independent-practice', title: '🧭 Go without labels', text: 'Fresh inputs, your own reasoning, spaced review' },
];
const config = JSON.stringify({ key: practice?.storageKey, ids: practice?.conceptIds || [] }).replace(/</g, '\\u003c');
let chapter = 0;
---
<div class="hub" data-pattern-hub>
  <p class="logline">{logline}</p>
  {cast.length > 0 && (
    <section class="cast" aria-label="Cast of characters">
      <h2 class="small-title">The cast</h2>
      <dl>{cast.map(member => <div><dt>{member.name}</dt><dd>{member.role}</dd></div>)}</dl>
    </section>
  )}
  {practice && (
    <div class="session-card">
      <div><span class="eyebrow">ONE GOOD SESSION AT A TIME</span><h2>Your next {sessionMinutes} minutes</h2><p data-hub-next>Read one chapter, play its puzzle, then try the prompt that surprised you.</p><p class="saved" data-hub-stats>Review progress stays in this browser.</p></div>
      <a class="session-button" href="#independent-practice">Start a short session →</a>
    </div>
  )}
  <nav class="routes" aria-label="Ways into this lesson">
    {routes.map(route => <a href={route.href}><strong>{route.title}</strong><span>{route.text}</span></a>)}
  </nav>
  <h2 class="small-title">Contents</h2>
  {note && <p class="map-note">{note}</p>}
  <nav class="families" aria-label="Chapters">
    {parts.map(part => <div class="family"><h3>{part.name}</h3><p>{part.description}</p><ol>{part.links.map(([id, label]) => <li><a href={`#${id}`}><span class="num">{++chapter}</span><span class="label">{label}</span><span aria-hidden="true">↗</span></a></li>)}</ol></div>)}
  </nav>
  {extensions.length > 0 && <div class="extensions"><strong>Side quests · change one rule.</strong><span> {extensions.map(([id, label], i) => <>{i > 0 && ' · '}<a href={`#${id}`}>{label}</a></>)}</span></div>}
  {extras.length > 0 && <p class="map-note extras">{extras.map(([id, label], i) => <>{i > 0 && ' · '}<a href={`#${id}`}>{label}</a></>)}</p>}
  <script type="application/json" data-hub-config set:html={config} />
</div>
<style>
  .hub { margin:1.5rem 0 2.5rem; }
  .logline { font-family:'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif; font-size:1.25rem; font-style:italic; line-height:1.6; color:#ece3d0; border-left:3px solid var(--accent); padding:.2rem 0 .2rem 1.1rem; margin:0 0 1.6rem; }
  .small-title { font-size:.72rem; letter-spacing:.18em; text-transform:uppercase; color:var(--text-dim); border:0; margin:1.8rem 0 .7rem; padding:0; }
  .cast dl { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:.6rem; margin:0; }
  .cast dl > div { border:1px solid var(--border); border-radius:10px; padding:.7rem .9rem; background:var(--bg-raised); }
  .cast dt { font-family:'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif; font-weight:700; color:var(--accent); font-size:1.02rem; }
  .cast dd { margin:.2rem 0 0; font-size:.83rem; color:var(--text-dim); line-height:1.5; }
  .session-card { display:flex; gap:1.5rem; align-items:center; justify-content:space-between; border:1px solid var(--accent-dim); border-radius:14px; background:linear-gradient(120deg,#292416,var(--bg-raised)); padding:1.4rem; margin-top:1.6rem; }
  .eyebrow { color:var(--accent); font-size:.68rem; font-weight:700; letter-spacing:.1em; }
  .session-card h2 { border:0; margin:.3rem 0; padding:0; font-size:1.5rem; }
  .session-card p { margin:.4rem 0; font-size:.9rem; }
  .session-card .saved { font-size:.75rem; color:var(--text-dim); }
  .session-button { padding:.7rem 1rem; color:var(--bg); background:var(--accent); border-radius:8px; white-space:nowrap; text-decoration:none; font-size:.85rem; font-weight:700; }
  .routes,.families { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:.8rem; margin:1rem 0; }
  .routes>a { padding:1rem; border:1px solid var(--border); border-radius:10px; text-decoration:none; color:var(--text); background:var(--bg-raised); }
  .routes>a:hover { border-color:var(--accent); }
  .routes strong,.routes span { display:block; }
  .routes span { font-size:.8rem; color:var(--text-dim); margin-top:.3rem; }
  .map-note { color:var(--text-dim); font-size:.85rem; }
  .family { border:1px solid var(--border); border-radius:10px; padding:1rem; }
  .family h3 { font-size:.95rem; margin:0; color:var(--blue); }
  .family:nth-child(2) h3 { color:var(--green); } .family:nth-child(3) h3 { color:var(--purple); } .family:nth-child(4) h3 { color:var(--accent); } .family:nth-child(5) h3 { color:var(--red); }
  .family p { font-size:.8rem; color:var(--text-dim); }
  .family ol { list-style:none; padding:0; margin:0; }
  .family li { border-top:1px solid var(--border); margin:0; }
  .family a { display:flex; gap:.55rem; align-items:baseline; padding:.5rem 0; color:var(--text); text-decoration:none; font-size:.86rem; }
  .family a .num { font-family:var(--mono); font-size:.7rem; color:var(--text-dim); min-width:1.3rem; }
  .family a .label { flex:1; }
  .family a:hover { color:var(--accent); }
  .family a > span:last-child { color:var(--text-dim); }
  .extensions { border-left:2px solid var(--accent); padding:.7rem 1rem; background:var(--bg-raised); font-size:.85rem; }
  .extras { margin-top:.8rem; }
  a:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  @media(max-width:650px) { .session-card { align-items:start; flex-direction:column; } .routes { gap:.5rem; } .logline { font-size:1.1rem; } }
</style>
<script>
  import { loadBookFor, reviewSummary, REVIEW_EVENT } from '../lib/review';
  document.querySelectorAll<HTMLElement>('[data-pattern-hub]').forEach(root => {
    const { key, ids }: { key?: string; ids: string[] } = JSON.parse(root.querySelector('[data-hub-config]')!.textContent!);
    if (!key || !root.querySelector("[data-hub-next]")) return;
    const paint = () => {
      const summary = reviewSummary(loadBookFor(key, ids), Date.now());
      root.querySelector('[data-hub-next]')!.textContent = summary.due ? `${summary.due} concepts are ready to revisit. Start with recall, then try another input.` : summary.practised ? 'Nothing is due yet. Read a new chapter or practise early; early repeats do not advance the review interval.' : 'Read one chapter, play its puzzle, then try the prompt that surprised you.';
      root.querySelector('[data-hub-stats]')!.textContent = `${summary.practised}/${ids.length} concepts practised · ${summary.due} due · saved on this browser`;
    };
    paint(); window.addEventListener(REVIEW_EVENT, paint); window.addEventListener('storage', paint);
  });
</script>
