---
// Thin reading-progress ribbon under the nav: how far through the story you are.
// Place once per lesson page, before the <article>.
---
<div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>
<script>
  const bar = document.querySelector<HTMLElement>('[data-read-progress]');
  const article = document.querySelector('article');
  const update = () => {
    if (!bar || !article) return;
    const box = article.getBoundingClientRect();
    const total = box.height - window.innerHeight;
    bar.style.transform = `scaleX(${total > 0 ? Math.min(1, Math.max(0, -box.top / total)) : 1})`;
  };
  addEventListener('scroll', update, { passive: true }); addEventListener('resize', update); update();
</script>
<style>
  .read-progress { position: sticky; top: 3.3rem; z-index: 40; height: 3px; margin: -1px 0 0; }
  .read-progress span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent-dim), var(--accent)); transform-origin: left; transform: scaleX(0); }
</style>
