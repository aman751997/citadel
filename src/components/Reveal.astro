---
// Predict-then-check box. Poses a question; answer stays hidden until clicked.
// Usage in MDX:
// <Reveal q="Why is volatile load-bearing here?">
//   ...markdown answer...
// </Reveal>
interface Props {
  q: string;
}
const { q } = Astro.props;
---
<details class="reveal">
  <summary><span class="reveal-tag">🤔 Predict first</span> {q} <span class="reveal-cta">— think, then click</span></summary>
  <div class="reveal-body"><slot /></div>
</details>

<style>
  .reveal {
    border: 1px dashed var(--accent-dim);
    border-radius: var(--radius);
    background: var(--bg-raised);
    margin: 1.4rem 0;
    padding: 0;
  }
  .reveal summary {
    cursor: pointer;
    padding: 0.85rem 1.1rem;
    font-weight: 600;
    list-style: none;
  }
  .reveal summary::-webkit-details-marker { display: none; }
  .reveal-tag {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 0.5rem;
  }
  .reveal-cta {
    color: var(--text-dim);
    font-weight: 400;
    font-size: 0.85rem;
  }
  .reveal[open] .reveal-cta { display: none; }
  .reveal[open] summary { border-bottom: 1px dashed var(--border); }
  .reveal-body {
    padding: 0.4rem 1.1rem 0.9rem;
    border-left: 2px solid var(--green);
    margin: 0.6rem 0.9rem 0.9rem;
  }
</style>
