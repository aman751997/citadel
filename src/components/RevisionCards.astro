---
// End-of-chapter flip cards with self-rating. Usage in MDX:
//   <RevisionCards id="solid-srp" cards={[{ front: 'What problem does SRP solve?', back: '...' }]} />
// Click / Enter / Space on a card reveals the answer; then "Got it" or "Review again". State: citadel-cards-v1:<pathname>:<id>.
// Without JS a definition list shows every front and back.
interface Props { id: string; cards: { front: string; back: string }[]; title?: string }
const { id, cards, title = 'Revision cards' } = Astro.props;
---
<section class="rc" data-rc data-id={id} aria-label={title}>
  <header class="rc-head">
    <strong>{title}</strong>
    <span class="rc-count" data-count aria-live="polite" hidden></span>
    <button type="button" class="rc-reset" data-reset hidden>Reset</button>
  </header>
  <div class="rc-list" data-list hidden>
    {cards.map((c, i) => (
      <div class="rc-card" data-card data-i={i}>
        <button type="button" class="rc-front" aria-expanded="false" aria-controls={`rc-${id}-${i}`} data-flip>
          <span class="rc-n">{i + 1}</span><span>{c.front}</span><span class="rc-state" data-state></span>
        </button>
        <div class="rc-back" id={`rc-${id}-${i}`} data-back hidden>
          <p>{c.back}</p>
          <div class="rc-actions">
            <button type="button" data-got>Got it</button>
            <button type="button" data-again>Review again</button>
          </div>
        </div>
      </div>
    ))}
  </div>
  <dl class="rc-nojs" data-nojs>
    {cards.map((c) => (<><dt>{c.front}</dt><dd>{c.back}</dd></>))}
  </dl>
</section>

<style>
  .rc { border: 1px solid var(--purple); border-radius: var(--radius); background: var(--bg-raised); padding: .9rem 1.1rem; margin: 1.8rem 0; }
  .rc-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem .9rem; margin-bottom: .6rem; }
  .rc-head strong { color: var(--purple); }
  .rc-count { font-family: var(--mono); font-size: .8rem; color: var(--text-dim); }
  .rc-reset { margin-left: auto; }
  .rc-list { display: grid; gap: .5rem; }
  .rc-card { border: 1px solid var(--border); border-radius: 8px; background: var(--bg); }
  .rc-card[data-status="got"] { border-color: var(--green); }
  .rc-card[data-status="again"] { border-color: var(--accent); }
  .rc-front { display: flex; gap: .6rem; align-items: baseline; width: 100%; text-align: left; background: transparent; color: var(--text); border: 0; padding: .65rem .8rem; font: inherit; cursor: pointer; border-radius: 8px; }
  .rc-front:hover { background: var(--bg-hover); }
  .rc-n { font-family: var(--mono); font-size: .75rem; color: var(--text-dim); }
  .rc-state { margin-left: auto; font-size: .75rem; font-weight: 700; white-space: nowrap; }
  .rc-card[data-status="got"] .rc-state { color: var(--green); }
  .rc-card[data-status="again"] .rc-state { color: var(--accent); }
  .rc-back { border-top: 1px dashed var(--border); padding: .2rem .8rem .7rem; }
  .rc-back[hidden], .rc-list[hidden], .rc-nojs[hidden], .rc-count[hidden], .rc-reset[hidden] { display: none; }
  .rc-back p { margin: .6rem 0; white-space: pre-wrap; }
  .rc-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .rc button:not(.rc-front) { background: transparent; color: var(--text); border: 1px solid var(--border); border-radius: 7px; padding: .4rem .85rem; font: inherit; font-size: .85rem; cursor: pointer; }
  .rc button:not(.rc-front):hover { background: var(--bg-hover); }
  .rc [data-got]:hover { border-color: var(--green); }
  .rc [data-again]:hover { border-color: var(--accent); }
  .rc button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rc-nojs dt { font-weight: 700; margin-top: .6rem; }
  .rc-nojs dd { margin: .2rem 0 0 1rem; color: var(--text-dim); }
  @media (max-width: 480px) { .rc { padding: .8rem; } .rc-actions button { flex: 1 1 auto; } }
</style>

<script>
  import { getJSON, setJSON, remove } from '../lib/learn-store.ts';
  type Status = 'got' | 'again' | null;

  document.querySelectorAll<HTMLElement>('[data-rc]').forEach((el) => {
    const key = `citadel-cards-v1:${location.pathname}:${el.dataset.id}`;
    const cards = [...el.querySelectorAll<HTMLElement>('[data-card]')];
    const stored = getJSON<Status[]>(key);
    const status: Status[] = cards.map((_, i) => (stored?.[i] === 'got' || stored?.[i] === 'again' ? stored[i] : null));
    const count = el.querySelector<HTMLElement>('[data-count]')!;
    const reset = el.querySelector<HTMLButtonElement>('[data-reset]')!;

    const paint = () => {
      cards.forEach((c, i) => {
        c.dataset.status = status[i] ?? '';
        c.querySelector<HTMLElement>('[data-state]')!.textContent = status[i] === 'got' ? '✓ Got it' : status[i] === 'again' ? '↻ Review again' : '';
      });
      count.textContent = `${status.filter((s) => s === 'got').length} of ${cards.length} got it`;
      reset.hidden = status.every((s) => s === null);
    };
    const save = () => (status.every((s) => s === null) ? remove(key) : setJSON(key, status));
    const flip = (c: HTMLElement, open: boolean) => {
      c.querySelector('[data-flip]')!.setAttribute('aria-expanded', String(open));
      c.querySelector<HTMLElement>('[data-back]')!.hidden = !open;
    };

    cards.forEach((c, i) => {
      const btn = c.querySelector<HTMLButtonElement>('[data-flip]')!;
      btn.addEventListener('click', () => flip(c, btn.getAttribute('aria-expanded') !== 'true'));
      const rate = (s: Status) => { status[i] = s; save(); paint(); flip(c, false); btn.focus(); };
      c.querySelector('[data-got]')!.addEventListener('click', () => rate('got'));
      c.querySelector('[data-again]')!.addEventListener('click', () => rate('again'));
    });
    reset.addEventListener('click', () => { status.fill(null); remove(key); paint(); cards.forEach((c) => flip(c, false)); });

    el.querySelector<HTMLElement>('[data-list]')!.hidden = false;
    el.querySelector<HTMLElement>('[data-nojs]')!.hidden = true;
    count.hidden = false;
    paint();
  });
</script>
