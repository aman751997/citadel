---
// A story beat: novel-style prose that opens a chapter or sets up a puzzle.
// Usage in MDX:
// <Scene chapter="Chapter 1" title="The folded word">
//   The gate of the old town carried a message...
// </Scene>
interface Props { chapter?: string; title?: string; mood?: 'dawn' | 'dusk' | 'night' | 'storm' }
const { chapter, title, mood = 'dusk' } = Astro.props;
---
<aside class:list={['scene', `mood-${mood}`]}>
  {(chapter || title) && <p class="scene-head">{chapter && <span class="scene-chapter">{chapter}</span>}{title && <span class="scene-title">{title}</span>}</p>}
  <div class="scene-body"><slot /></div>
</aside>
<style>
  .scene {
    --ink: #ece3d0;
    position: relative;
    margin: 2rem 0 1.6rem;
    padding: 1.4rem 1.6rem 1.1rem;
    border-radius: 14px;
    border: 1px solid #3a3326;
    background: linear-gradient(160deg, #221d14 0%, #17140f 60%, var(--bg-raised) 100%);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Charter, Georgia, serif;
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--ink);
  }
  .mood-dawn { background: linear-gradient(160deg, #2a2216 0%, #1b1a1c 70%, var(--bg-raised)); border-color: #4a3d25; }
  .mood-night { background: linear-gradient(160deg, #141a2a 0%, #11141c 70%, var(--bg-raised)); border-color: #26304a; }
  .mood-storm { background: linear-gradient(160deg, #18222a 0%, #121619 70%, var(--bg-raised)); border-color: #2b3b45; }
  .scene-head { margin: 0 0 .7rem; font-family: var(--font); display: flex; gap: .7rem; align-items: baseline; flex-wrap: wrap; }
  .scene-chapter { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
  .scene-title { font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif; font-style: italic; font-size: 1.15rem; color: var(--ink); }
  .scene-body :global(p) { margin: .55rem 0; }
  .scene-body :global(p:first-child::first-letter) { float: left; font-size: 2.9em; line-height: .9; padding: .12em .12em 0 0; color: var(--accent); font-weight: 600; }
  .scene-body :global(em) { color: #f3e6c4; }
  .scene-body :global(strong) { color: #fff3d6; font-weight: 600; }
  .scene-body :global(code) { font-size: .82em; }
  .scene-body :global(blockquote) { border-left: 2px solid var(--accent-dim); margin: .8rem 0; padding-left: 1rem; font-style: italic; color: #d9cfb8; }
  @media (max-width: 480px) { .scene { padding: 1.1rem 1.1rem .9rem; font-size: 1.02rem; } }
</style>
