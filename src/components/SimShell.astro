---
// Frame for every interactive simulation: title, optional step controls, no-JS fallback, shared styles.
// Usage in MDX:
//   <SimShell title="Optimistic locking" stepper fallback="Plain-text walkthrough shown when JavaScript is off.">
//     <MySim />   (any markup; the sim's own script finds [data-sim-root] ancestors)
//   </SimShell>
// With `stepper`, the shell renders Back / Next / Play / Reset buttons plus a live caption
// ([data-sim-caption]) and wires them via src/lib/sim.ts when the child sim calls `mountStepper`.
interface Props { title: string; caption?: string; stepper?: boolean; fallback: string }
const { title, caption, stepper = false, fallback } = Astro.props;
---
<section class="sim" data-sim-root aria-label={title}>
  <header><strong>{title}</strong><span class="sim-tag">Simulation</span></header>
  {caption && <p class="sim-caption-top">{caption}</p>}
  <div class="sim-stage"><slot /></div>
  {stepper && (
    <div class="sim-controls" role="group" aria-label="Simulation controls">
      <button type="button" data-sim-prev>← Back</button>
      <button type="button" data-sim-next>Next step →</button>
      <button type="button" data-sim-play aria-pressed="false">▶ Play</button>
      <button type="button" data-sim-reset>Reset</button>
      <span class="sim-count" data-sim-count></span>
    </div>
  )}
  {stepper && <p class="sim-live" data-sim-caption role="status" aria-live="polite" aria-atomic="true"></p>}
  <noscript><p class="sim-fallback">{fallback}</p></noscript>
</section>

<style is:global>
  .sim { border: 1px solid var(--blue); border-radius: 12px; background: var(--bg-raised); padding: 1rem 1.1rem; margin: 1.6rem 0; }
  .sim > header { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; flex-wrap: wrap; margin-bottom: .6rem; }
  .sim > header strong { color: var(--blue); }
  .sim-tag { font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); font-weight: 700; }
  .sim-caption-top { color: var(--text-dim); font-size: .9rem; margin: .2rem 0 .8rem; }
  .sim-stage { overflow-x: auto; }
  .sim-controls, .sim .sim-row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-top: .8rem; }
  .sim button { background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 7px; padding: .5rem .8rem; font: inherit; font-size: .85rem; cursor: pointer; }
  .sim button:hover:not(:disabled) { border-color: var(--blue); }
  .sim button:focus-visible, .sim input:focus-visible, .sim select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sim button:disabled { opacity: .45; cursor: default; }
  .sim button[aria-pressed="true"] { border-color: var(--green); color: var(--green); }
  .sim-count { margin-left: auto; font-family: var(--mono); font-size: .8rem; color: var(--text-dim); }
  .sim-live { border-left: 3px solid var(--blue); padding-left: .8rem; margin: .8rem 0 0; min-height: 3.2em; }
  .sim-fallback { border-left: 3px solid var(--accent); padding-left: .8rem; color: var(--text-dim); }
  .sim label { font-size: .85rem; color: var(--text-dim); display: flex; flex-direction: column; gap: .2rem; min-width: 150px; flex: 1; }
  .sim label output { font-family: var(--mono); color: var(--text); }
  .sim input[type="range"] { width: 100%; }
  .sim .sim-lane { display: grid; grid-template-columns: 6.5rem 1fr; gap: .5rem; align-items: center; margin: .35rem 0; font-size: .8rem; }
  .sim .sim-lane > span:first-child { color: var(--text-dim); font-family: var(--mono); }
  .sim .sim-track { position: relative; height: 1.7rem; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
  .sim .sim-chip { position: absolute; top: 2px; bottom: 2px; border-radius: 4px; padding: 0 .4rem; font-size: .7rem; line-height: 1.4rem; white-space: nowrap; background: #58a6ff30; border: 1px solid var(--blue); }
  .sim .sim-chip.ok { background: #3fb95030; border-color: var(--green); }
  .sim .sim-chip.bad { background: #f8514930; border-color: var(--red); }
  .sim .sim-chip.warn { background: #e3b34130; border-color: var(--accent); }
  .sim .sim-stat { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: .5rem .7rem; min-width: 7rem; }
  .sim .sim-stat b { display: block; font-family: var(--mono); font-size: 1.15rem; }
  .sim .sim-stat small { color: var(--text-dim); font-size: .72rem; }
  @media (max-width: 480px) { .sim { padding: .8rem; } .sim .sim-lane { grid-template-columns: 4.5rem 1fr; } .sim-controls button { flex: 1 1 auto; } }
  @media (prefers-reduced-motion: reduce) { .sim * { transition: none !important; animation: none !important; } }
</style>
