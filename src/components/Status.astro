---
// Inline status lozenge — the render target for Confluence's status macro when
// a wiki page is synced into the Mastery wing. Usage in MDX:
//   <Status color="green">Proven</Status>
interface Props {
  color?: 'green' | 'red' | 'yellow' | 'blue' | 'purple' | 'neutral';
}
const { color = 'neutral' } = Astro.props;
---
<span class:list={['lozenge', `lozenge-${color}`]}><slot /></span>

<style>
  .lozenge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-family: var(--mono);
    border-radius: 4px;
    padding: 0.08em 0.45em;
    border: 1px solid currentColor;
    white-space: nowrap;
    vertical-align: baseline;
  }
  .lozenge-neutral { color: var(--text-dim); background: rgba(145, 152, 161, 0.12); }
  .lozenge-green { color: var(--green); background: rgba(63, 185, 80, 0.12); }
  .lozenge-red { color: var(--red); background: rgba(248, 81, 73, 0.12); }
  .lozenge-yellow { color: var(--accent); background: rgba(227, 179, 65, 0.12); }
  .lozenge-blue { color: var(--blue); background: rgba(88, 166, 255, 0.12); }
  .lozenge-purple { color: var(--purple); background: rgba(188, 140, 255, 0.12); }
</style>
