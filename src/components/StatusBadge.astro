---
// Inline factual-accuracy badge. Colour, icon AND text label always travel together (never colour alone).
//   <StatusBadge kind="implemented|tested|planned|hypothetical|unverified" />   optional: label="..."
interface Props { kind: 'implemented' | 'tested' | 'planned' | 'hypothetical' | 'unverified'; label?: string }
const META = {
  implemented: { icon: '✔', text: 'Implemented', tip: 'Exists in the real codebase' },
  tested: { icon: '◆', text: 'Tested', tip: 'Tested or prototyped' },
  planned: { icon: '▸', text: 'Planned', tip: 'Planned, not built yet' },
  hypothetical: { icon: '✦', text: 'Hypothetical', tip: 'A hypothetical improvement' },
  unverified: { icon: '⚠', text: 'Unverified', tip: 'The source does not establish this' },
} as const;
const { kind, label } = Astro.props;
const m = META[kind];
---
<span class={`sb sb-${kind}`} title={m.tip}><span class="sb-i" aria-hidden="true">{m.icon}</span>{label ?? m.text}</span>

<style>
  .sb { display: inline-flex; align-items: baseline; gap: .3em; font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; font-family: var(--mono); border: 1px solid currentColor; border-radius: 4px; padding: .08em .45em; white-space: nowrap; vertical-align: baseline; }
  .sb-implemented { color: var(--green); background: rgba(63, 185, 80, .12); }
  .sb-tested { color: var(--blue); background: rgba(88, 166, 255, .12); }
  .sb-planned { color: var(--purple); background: rgba(188, 140, 255, .12); }
  .sb-hypothetical { color: var(--accent); background: rgba(227, 179, 65, .12); border-style: dotted; }
  .sb-unverified { color: var(--red); background: rgba(248, 81, 73, .12); border-style: dashed; }
</style>
