---
// Explains the five StatusBadge kinds. Place once near the top of a page that uses them: <StatusLegend />
import StatusBadge from './StatusBadge.astro';
const rows = [
  ['implemented', 'In the real codebase.'],
  ['tested', 'Tested or prototyped, but not necessarily in production code.'],
  ['planned', 'Decided or scheduled, not built yet.'],
  ['hypothetical', 'A possible improvement that nobody has committed to.'],
  ['unverified', 'The source does not establish it; treat with care.'],
] as const;
---
<ul class="sl" aria-label="Status legend">
  {rows.map(([k, d]) => (<li><StatusBadge kind={k} /><span>{d}</span></li>))}
</ul>

<style>
  .sl { list-style: none; margin: 1rem 0; padding: .6rem .9rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-raised); display: grid; gap: .4rem; }
  .sl li { display: flex; flex-wrap: wrap; gap: .3rem .7rem; align-items: baseline; font-size: .88rem; color: var(--text-dim); margin: 0; }
  .sl li :global(.sb) { min-width: 8.5rem; justify-content: flex-start; }
</style>
