---
import SimShell from '../SimShell.astro';
import { STREAM, HASHES, WIDTH } from '../../lib/sim/countmin.ts';
const stream = STREAM.join(', ');
const fallback = `Stream: ${stream}. The sketch has 2 rows of ${WIDTH} counters. Each update adds 1 to one counter per row, chosen by that row's hash of the item. After seven updates row 1 is [4, 0, 2, 0, 1] and row 2 is [0, 1, 3, 3, 0]. To query an item, take the minimum of its counters. cat: min(4, 3) = 3 (true 3). dog: min(2, 3) = 2 (true 2). eel: min(4, 3) = 3 (true 1, overcounted because it collides with cat in row 1 and with dog in row 2). fox: min(1, 1) = 1. With one row only, cat would read 4. A Count-Min Sketch never undercounts; collisions only add.`;
---
<SimShell title="Count-Min Sketch: collisions and the minimum" stepper fallback={fallback}>
  <div class="cms" data-cms>
    <p class="cms-stream">Stream: {stream}</p>
    <fieldset class="cms-modes">
      <legend>Rows (hash functions)</legend>
      <label><input type="radio" value="2" checked /> 2 rows (take the minimum)</label>
      <label><input type="radio" value="1" /> 1 row (no minimum to help)</label>
    </fieldset>
    <div data-grid></div>
    <p class="cms-hash">Columns per row, by item: {Object.entries(HASHES).map(([k, v]) => `${k} → ${v.join(' / ')}`).join(' · ')}</p>
  </div>
</SimShell>

<style is:global>
  .cms-stream, .cms-hash { font-family: var(--mono); font-size: .8rem; color: var(--text-dim); margin: .3rem 0; overflow-wrap: anywhere; }
  .cms fieldset { border: 1px solid var(--border); border-radius: 8px; display: flex; flex-wrap: wrap; gap: .3rem 1rem; padding: .4rem .7rem .6rem; margin: .5rem 0 .8rem; }
  .cms legend { font-size: .75rem; color: var(--text-dim); padding: 0 .3rem; }
  .sim .cms fieldset label { flex-direction: row; align-items: center; gap: .4rem; min-width: 0; flex: 0 1 auto; color: var(--text); }
  .cms-row { display: grid; grid-template-columns: 3.2rem repeat(5, 1fr); gap: .35rem; margin: .35rem 0; align-items: center; font-size: .8rem; }
  .cms-cell { background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: .45rem 0; text-align: center; font-family: var(--mono); }
  .cms-cell.hit { border-color: var(--blue); color: var(--blue); font-weight: 700; }
</style>

<script>
  import { mountStepper } from '../../lib/sim.ts';
  import { buildSteps } from '../../lib/sim/countmin.ts';

  document.querySelectorAll<HTMLElement>('[data-cms]').forEach((el, n) => {
    const root = el.closest<HTMLElement>('[data-sim-root]')!;
    const grid = el.querySelector<HTMLElement>('[data-grid]')!;
    const radios = [...el.querySelectorAll<HTMLInputElement>('input[type=radio]')];
    radios.forEach((r) => { r.name = `cms-rows-${n}`; });
    let rows: 1 | 2 = 2;
    const steps = buildSteps(rows);
    mountStepper(root, {
      steps,
      render(s) {
        grid.replaceChildren(...s.table.map((row, r) => {
          const line = document.createElement('div');
          line.className = 'cms-row';
          const label = document.createElement('span');
          label.textContent = `row ${r + 1}`;
          line.append(label, ...row.map((v, c) => {
            const cell = document.createElement('span');
            cell.className = 'cms-cell' + (s.touched.some(([tr, tc]) => tr === r && tc === c) ? ' hit' : '');
            cell.textContent = String(v);
            return cell;
          }));
          return line;
        }));
      },
    });
    radios.forEach((r) => r.addEventListener('change', () => {
      rows = Number(r.value) as 1 | 2;
      steps.splice(0, steps.length, ...buildSteps(rows));
      root.querySelector<HTMLButtonElement>('[data-sim-reset]')!.click();
    }));
  });
</script>
