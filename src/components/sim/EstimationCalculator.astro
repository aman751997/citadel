---
import SimShell from '../SimShell.astro';
// Props (all optional): the starting slider values. DAU, ratio and payload sliders are log-scale (values are 10^x).
interface Props { dau?: number; actionsPerUser?: number; readsPerWrite?: number; payloadKB?: number; retentionYears?: number; replication?: number; peakFactor?: number }
const { dau = 50000000, actionsPerUser = 10, readsPerWrite = 100, payloadKB = 1, retentionYears = 5, replication = 3, peakFactor = 3 } = Astro.props;
const exp = (v: number) => Math.round(Math.log10(v) * 10) / 10;
const fallback = `With no JavaScript, here is one worked run. 50 million daily users, 10 actions each, 100 reads per write, 1 KB per action, 5 years kept, 3 copies, peak 3x, 100,000 seconds per day. Actions: 500M a day, about 4.95M writes and 495M reads. Average QPS: 5,000 total, about 50 writes and 4,950 reads. Peak QPS: 15,000. Storage: 4.95M writes x 1 KB = about 5 GB a day, about 1.8 TB a year, about 9 TB over five years, about 27 TB on disk with three copies. Peak read bandwidth: 4,950 x 3 x 1 KB = about 15 MB/s, about 0.12 Gbps.`;
---
<SimShell title="Estimation calculator: users to QPS, storage and bandwidth" fallback={fallback}>
  <div class="est" data-est>
    <p class="est-note">Drag a slider and watch every number move. Average QPS = actions per day divided by seconds per day; peak = average x peak factor; storage is written bytes x 365 x years x copies; bandwidth = QPS x payload x 8 bits.</p>
    <div class="sim-row">
      <label>Daily active users <output data-o="dau"></output>
        <input type="range" min="3" max="9.5" step="0.1" value={exp(dau)} data-in="dau" data-log /></label>
      <label>Actions per user per day <output data-o="actionsPerUser"></output>
        <input type="range" min="1" max="100" step="1" value={actionsPerUser} data-in="actionsPerUser" /></label>
      <label>Reads per write <output data-o="readsPerWrite"></output>
        <input type="range" min="0" max="3" step="0.1" value={exp(readsPerWrite)} data-in="readsPerWrite" data-log /></label>
    </div>
    <div class="sim-row">
      <label>Payload per action <output data-o="payloadKB"></output>
        <input type="range" min="-1" max="5" step="0.1" value={exp(payloadKB)} data-in="payloadKB" data-log /></label>
      <label>Retention (years) <output data-o="retentionYears"></output>
        <input type="range" min="1" max="10" step="1" value={retentionYears} data-in="retentionYears" /></label>
      <label>Copies on disk (replication) <output data-o="replication"></output>
        <input type="range" min="1" max="5" step="1" value={replication} data-in="replication" /></label>
      <label>Peak factor <output data-o="peakFactor"></output>
        <input type="range" min="1" max="10" step="0.5" value={peakFactor} data-in="peakFactor" /></label>
    </div>
    <div class="sim-row">
      <label class="est-check"><input type="checkbox" checked data-in="roundDay" /> Use 100,000 s/day (the lesson's rule). Untick for exact 86,400.</label>
    </div>
    <div class="sim-row est-stats">
      <div class="sim-stat"><b data-s="avgQps"></b><small>average QPS</small></div>
      <div class="sim-stat"><b data-s="peakQps"></b><small>peak QPS</small></div>
      <div class="sim-stat"><b data-s="split"></b><small>peak reads / writes per s</small></div>
    </div>
    <div class="sim-row est-stats">
      <div class="sim-stat"><b data-s="perDay"></b><small>new data per day</small></div>
      <div class="sim-stat"><b data-s="perYear"></b><small>new data per year</small></div>
      <div class="sim-stat"><b data-s="raw"></b><small>on disk after retention and copies</small></div>
    </div>
    <div class="sim-row est-stats">
      <div class="sim-stat"><b data-s="egress"></b><small>peak egress (reads out)</small></div>
      <div class="sim-stat"><b data-s="ingress"></b><small>peak ingress (writes in)</small></div>
    </div>
    <p class="sim-live" role="status" aria-live="polite" aria-atomic="true" data-caption></p>
    <p class="est-note">Model assumptions: every action moves one payload; only writes are stored; peak applies to QPS and bandwidth but not to storage; decimal units (1 KB = 1,000 B); no index overhead, compression or growth in users.</p>
  </div>
</SimShell>

<style is:global>
  .est input[type="range"] { margin: 0; }
  .est label { flex: 1 1 11rem; }
  .est .est-check { flex: 1 1 100%; }
  .est .est-check input { margin-right: .4rem; }
  .est-note { color: var(--text-dim); font-size: .78rem; margin: .8rem 0 0; }
  .est-stats .sim-stat { flex: 1 1 8rem; }
</style>

<script>
  import { estimate, humanBytes, humanCount, fromLog, type Input } from '../../lib/sim/estimation.ts';

  document.querySelectorAll<HTMLElement>('[data-est]').forEach((el) => {
    const q = <T extends HTMLElement>(s: string) => el.querySelector<T>(s)!;
    const input = (k: string) => q<HTMLInputElement>(`[data-in=${k}]`);
    const val = (k: string) => { const n = input(k); const v = Number(n.value); return n.hasAttribute('data-log') ? fromLog(v) : v; };
    const label = (k: string, v: number) => k === 'payloadKB' ? humanBytes(v * 1000)
      : k === 'dau' || k === 'readsPerWrite' ? humanCount(v) : k === 'peakFactor' ? `${v}x` : String(v);
    const render = () => {
      const i: Input = { dau: val('dau'), actionsPerUser: val('actionsPerUser'), readsPerWrite: val('readsPerWrite'), payloadKB: val('payloadKB'),
        retentionYears: val('retentionYears'), replication: val('replication'), peakFactor: val('peakFactor'),
        secondsPerDay: input('roundDay').checked ? 100000 : 86400 };
      for (const k of ['dau', 'actionsPerUser', 'readsPerWrite', 'payloadKB', 'retentionYears', 'replication', 'peakFactor'] as const) {
        q(`[data-o=${k}]`).textContent = label(k, i[k]);
      }
      const r = estimate(i);
      const set = (k: string, t: string) => { q(`[data-s=${k}]`).textContent = t; };
      set('avgQps', humanCount(r.avgQps));
      set('peakQps', humanCount(r.peakQps));
      set('split', `${humanCount(r.peakReadQps)} / ${humanCount(r.peakWriteQps)}`);
      set('perDay', humanBytes(r.storageDayBytes));
      set('perYear', humanBytes(r.storageYearBytes));
      set('raw', humanBytes(r.storageRawBytes));
      set('egress', `${humanBytes(r.egressPeakBytesPerSec, '/s')} (${Number(r.egressPeakGbps.toPrecision(3))} Gbps)`);
      set('ingress', `${humanBytes(r.ingressPeakBytesPerSec, '/s')} (${Number(r.ingressPeakGbps.toPrecision(3))} Gbps)`);
      const hint = r.egressPeakGbps > 10 ? 'Egress this large is a CDN decision.' : r.egressPeakGbps < 1 ? 'Bandwidth is small: say so out loud and skip it.' : 'Bandwidth is worth a line, but a fleet can spread it.';
      const store = r.storageRetainedBytes > 2e13 ? 'Storage is well past one comfortable database node: plan shards or object storage.' : r.storageRetainedBytes > 2e12 ? 'Storage is a few terabytes: one node still works, with a partition plan.' : 'Storage fits one node.';
      q('[data-caption]').textContent = `${store} ${hint}`;
    };
    el.querySelectorAll('[data-in]').forEach((n) => n.addEventListener('input', render));
    render();
  });
</script>
