---
interface Props {
  title: string;
  description?: string;
  track?: 'sd' | 'dsa' | 'lld' | 'mastery';
}
import { BASE as base } from '../paths';
const { title, description = 'Personal interview prep portal', track } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · The Citadel</title>
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏰</text></svg>`} />
  </head>
  <body>
    <nav class="topnav">
      <a href={base} class="brand">🏰 The Citadel</a>
      <div class="navlinks">
        {track === 'sd' && (
          <>
            <span class="track-chip sd-chip">SD wing</span>
            <a href={`${base}sd/`}>Roadmap</a>
            <a href={`${base}sd/bank/`}>Question Bank</a>
            <a href={`${base}sd/framework/`}>Cheat Sheet</a>
            <a href={`${base}sd/#war-room`}>War Room</a>
          </>
        )}
        {track === 'dsa' && (
          <>
            <span class="track-chip dsa-chip">DSA wing</span>
            <a href={`${base}dsa/`}>Arsenal</a>
          </>
        )}
        {track === 'lld' && (
          <>
            <span class="track-chip lld-chip">LLD wing</span>
            <a href={`${base}lld/`}>Roadmap</a>
            <a href={`${base}lld/#war-room`}>War Room</a>
          </>
        )}
        {track === 'mastery' && (
          <>
            <span class="track-chip mastery-chip">Mastery wing</span>
            <a href={`${base}mastery/`}>Dossiers</a>
          </>
        )}
        {!track && (
          <>
            <a href={`${base}sd/`}>System Design</a>
            <a href={`${base}dsa/`}>DSA</a>
            <a href={`${base}lld/`}>LLD</a>
            <a href={`${base}mastery/`}>Mastery</a>
          </>
        )}
      </div>
      <span id="xp-badge" class="xp-badge" title="Lessons completed"></span>
      <button id="sync-ctl" class="sync-ctl" type="button" title="Progress → git sync"></button>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      Forged for one engineer's climb to the FAANG Citadel · progress auto-syncs to git when linked
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d1117;
    --bg-raised: #161b22;
    --bg-hover: #1c2330;
    --border: #2d333b;
    --text: #e6edf3;
    --text-dim: #9198a1;
    --accent: #e3b341;
    --accent-dim: #bb8f2c;
    --green: #3fb950;
    --blue: #58a6ff;
    --red: #f85149;
    --purple: #bc8cff;
    --radius: 10px;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    line-height: 1.65;
    font-size: 16px;
  }
  :not(pre) > code { overflow-wrap: anywhere; }
  pre { max-width: 100%; overflow-x: auto; }
  @media (max-width: 640px) { article { overflow-x: clip; } }
  details { min-width: 0; }
  .topnav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.85rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: rgba(13, 17, 23, 0.92);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .brand {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .navlinks { display: flex; gap: 1.1rem; flex: 1; align-items: center; flex-wrap: wrap; }
  @media (max-width: 640px) {
    .topnav { flex-wrap: wrap; gap: .5rem .9rem; padding: .6rem 1rem; }
    .navlinks { flex-basis: 100%; order: 3; gap: .4rem .9rem; }
    .sync-ctl, .xp-badge { font-size: .72rem; }
  }
  .track-chip {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    border-radius: 99px; padding: 0.15rem 0.6rem;
  }
  .sd-chip { background: rgba(88, 166, 255, 0.14); color: var(--blue); border: 1px solid var(--blue); }
  .dsa-chip { background: rgba(227, 179, 65, 0.14); color: var(--accent); border: 1px solid var(--accent-dim); }
  .lld-chip { background: rgba(63, 185, 80, 0.14); color: var(--green); border: 1px solid var(--green); }
  .mastery-chip { background: rgba(188, 140, 255, 0.14); color: var(--purple); border: 1px solid var(--purple); }
  .navlinks a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .navlinks a:hover { color: var(--text); }
  .xp-badge {
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 600;
    font-family: var(--mono);
  }
  .sync-ctl {
    background: none;
    border: 1px solid var(--border);
    border-radius: 99px;
    color: var(--text-dim);
    font-size: 0.72rem;
    font-family: var(--mono);
    padding: 0.15rem 0.6rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .sync-ctl:hover { border-color: var(--accent-dim); color: var(--text); }
  .sync-ctl.on { border-color: rgba(63, 185, 80, 0.5); color: var(--green); }
  .sync-ctl.err { border-color: var(--red); color: var(--red); }
  main { max-width: 880px; margin: 0 auto; padding: 2.2rem 1.4rem 4rem; }
  footer {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.8rem;
    padding: 2rem 1rem 3rem;
    border-top: 1px solid var(--border);
  }
  h1 { font-size: 1.9rem; line-height: 1.25; margin: 0 0 0.4rem; }
  h2 { font-size: 1.4rem; margin: 2.2rem 0 0.7rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--border); }
  h3 { font-size: 1.12rem; margin: 1.7rem 0 0.5rem; }
  a { color: var(--blue); }
  p { margin: 0.8rem 0; }
  ul, ol { padding-left: 1.4rem; }
  li { margin: 0.3rem 0; }
  code {
    font-family: var(--mono);
    font-size: 0.86em;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.12em 0.35em;
  }
  pre {
    background: var(--bg-raised) !important;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
  }
  pre code { background: none; border: none; padding: 0; }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 1rem 0;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }
  th, td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  th { background: var(--bg-raised); }
  blockquote {
    margin: 1rem 0;
    padding: 0.6rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-dim);
  }
  blockquote p { margin: 0.4rem 0; }
  hr { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
</style>

<script>
  // XP badge in nav: baked (git-synced) completions + localStorage overlay of unsynced ones
  import { SD_DONE } from '../progress';
  import { getToken, setToken, clearToken, sync, hasPending } from '../sync';

  const local = JSON.parse(localStorage.getItem('sdc-progress') || '[]');
  const done = new Set([...SD_DONE, ...local]);
  const badge = document.getElementById('xp-badge');
  if (badge && done.size > 0) badge.textContent = `⚡ ${done.size} cleared`;

  // Git-sync control: shows link state, click to link a token or force a sync now.
  const ctl = document.getElementById('sync-ctl') as HTMLButtonElement;
  const paint = (msg?: string) => {
    ctl.classList.toggle('on', !!getToken());
    ctl.classList.remove('err');
    ctl.textContent = msg ?? (getToken() ? '🔗 git sync on' : '🔗 link git sync');
    if (msg?.startsWith('⚠️')) ctl.classList.add('err');
  };
  paint();

  const TOKEN_HELP = [
    'Link progress auto-sync to GitHub.',
    '',
    'Create a fine-grained personal access token at',
    'github.com → Settings → Developer settings → Fine-grained tokens:',
    '  • Repository access: ONLY aman751997/citadel',
    '  • Permissions: Contents → Read and write (nothing else)',
    '',
    'The token is stored only in this browser and sent only to api.github.com.',
    'Paste it here (leave empty + OK to unlink):',
  ].join('\n');

  ctl.addEventListener('click', async () => {
    if (!getToken()) {
      const t = window.prompt(TOKEN_HELP);
      if (t === null) return;
      if (!t.trim()) { clearToken(); paint(); return; }
      setToken(t);
    }
    await sync(paint);
    setTimeout(() => paint(), 3000);
  });

  // On-load sweep: anything completed while sync was failing/offline gets pushed now.
  if (getToken() && hasPending()) void sync(paint).then(() => setTimeout(() => paint(), 3000));
</script>
