---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ReadProgress from '../../../components/ReadProgress.astro';
import { BASE } from '../../../paths';

export async function getStaticPaths() {
  const lessons = await getCollection('dsa');
  return lessons.map((lesson) => ({ params: { slug: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const all = (await getCollection('dsa')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((l) => l.id === lesson.id);
const next = all[idx + 1];
const prev = all[idx - 1];
---
<Base title={lesson.data.title} description={lesson.data.description} track="dsa">
  <ReadProgress />
  <article>
    <p class="crumb"><a href={`${BASE}dsa/`}>← DSA Arsenal</a> · pattern lesson · {lesson.data.sessionMinutes ? `~${lesson.data.sessionMinutes} min per session · ${lesson.data.minutes} min full guide` : `~${lesson.data.minutes} min`}</p>
    <h1>{lesson.data.title}</h1>
    <p class="lede">{lesson.data.description}</p>
    <hr />
    <Content />
    <nav class="lesson-nav">
      {prev ? <a href={`${BASE}dsa/lessons/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`${BASE}dsa/lessons/${next.id}/`} class="next">{next.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .crumb { font-size: 0.85rem; color: var(--text-dim); }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--text); }
  .lede { color: var(--text-dim); font-size: 1.05rem; margin-top: 0; }
  .lesson-nav {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .lesson-nav a { text-decoration: none; }
</style>
