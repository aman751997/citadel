---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BASE as base } from '../../paths';

const notes = (await getCollection('field')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const features = notes.filter((n) => n.data.kind === 'feature');
const drills = notes.filter((n) => n.data.kind === 'drill');
---
<Base title="Field Notes" description="Interview-worthy features built at work, and the closed-book grills on them" track="field">
  <header class="hero">
    <h1>🛠️ Field Notes</h1>
    <p class="sub">
      Hand-written, as features ship: the things from the day job worth talking about in an interview —
      how they work, why they were built that way, the bugs that taught something, and model answers.
      Grill drills record each closed-book session: the score, the gaps, and the answer to say next time.
    </p>
  </header>

  <h2>Features</h2>
  <div class="grid">
    {features.map((n) => (
      <a class="note" href={`${base}field-notes/${n.id}/`}>
        <h3>{n.data.title}</h3>
        <p class="desc">{n.data.description}</p>
        <p class="meta">{n.data.date} · ~{n.data.minutes} min{n.data.status ? ` · ${n.data.status}` : ''}</p>
      </a>
    ))}
  </div>

  {drills.length > 0 && (
    <>
      <h2>Grill drills</h2>
      <div class="grid">
        {drills.map((n) => (
          <a class="note" href={`${base}field-notes/${n.id}/`}>
            <h3>{n.data.title}</h3>
            <p class="desc">{n.data.description}</p>
            <p class="meta">{n.data.date} · ~{n.data.minutes} min</p>
          </a>
        ))}
      </div>
    </>
  )}
</Base>

<style>
  .hero { margin-bottom: 1.5rem; }
  .sub { color: var(--text-dim); max-width: 64ch; }
  .grid { display: grid; gap: 0.9rem; margin-bottom: 2rem; }
  .note {
    display: block; padding: 1.1rem 1.3rem;
    background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius);
    text-decoration: none; color: var(--text); transition: border-color 0.15s, background 0.15s;
  }
  .note:hover { border-color: var(--red); background: var(--bg-hover); }
  .note h3 { margin: 0 0 0.3rem; font-size: 1.1rem; }
  .desc { color: var(--text-dim); font-size: 0.9rem; margin: 0; }
  .meta { font-family: var(--mono); font-size: 0.75rem; color: var(--text-dim); margin: 0.5rem 0 0; }
</style>
