---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { DSA } from '../dsa';
import { MASTERY_PROJECTS } from '../mastery-projects';
import { BASE } from '../paths';

const sdLessons = await getCollection('lessons');
const lldWar = (await getCollection('war')).filter((p) => p.id.startsWith('lld/'));
const lldLessons = await getCollection('lld');
const dsaTotal = DSA.reduce((s, p) => s + p.problems.length, 0);
const dsaDone = DSA.reduce((s, p) => s + p.problems.filter((q) => q.done).length, 0);
const masteryChapters = await getCollection('mastery');
const fieldNotes = await getCollection('field');
const masteryProjects = MASTERY_PROJECTS.filter((p) =>
  masteryChapters.some((c) => c.data.project === p.slug)
);
---
<Base title="The Citadel">
  <header class="hero">
    <h1>🏰 The Citadel</h1>
    <p class="sub">
      One engineer's private war college. Four wings — three disciplines and your own war record. Pick today's fight.
      Somewhere past the misty mountains, the Gatekeeper is waiting.
    </p>
  </header>

  <div class="tracks">
    <a class="track sd" href={`${BASE}sd/`}>
      <div class="track-icon">🏗️</div>
      <h2>System Design</h2>
      <p>12 pattern-first modules · {sdLessons.length} lessons forged · quizzes, diagrams, walkthroughs.
      Lessons unlock in order; each ends in a live rep with the buddy.</p>
      <span class="cta">Enter the SD wing →</span>
    </a>
    <a class="track dsa" href={`${BASE}dsa/`}>
      <div class="track-icon">⚔️</div>
      <h2>DSA</h2>
      <p>20 patterns · {dsaTotal} problems, every one linked · {dsaDone} slain.
      Pattern lessons with Java templates, invariants, and your own bug bestiary.</p>
      <span class="cta">Enter the Arsenal →</span>
    </a>
    <a class="track lld" href={`${BASE}lld/`}>
      <div class="track-icon">🧩</div>
      <h2>LLD</h2>
      <p>Machine-coding wing: {lldLessons.length} gated lessons across 4 modules — object modeling to the
      classic-problem canon — plus a War Room of {lldWar.length} battle-tested dossiers from production code.</p>
      <span class="cta">Enter the LLD wing →</span>
    </a>
    <a class="track mastery" href={`${BASE}mastery/`}>
      <div class="track-icon">📓</div>
      <h2>Mastery</h2>
      <p>{masteryProjects.length} project dossiers · {masteryChapters.length} chapters.
      The systems you actually shipped, drilled to interview depth — for when they say "walk me through your work".</p>
      <span class="cta">Enter the Mastery wing →</span>
    </a>
    <a class="track field" href={`${BASE}field-notes/`}>
      <div class="track-icon">🛠️</div>
      <h2>Field Notes</h2>
      <p>{fieldNotes.filter((n) => n.data.kind === 'feature').length} features · {fieldNotes.filter((n) => n.data.kind === 'drill').length} grill drills.
      Interview-worthy things built at work, written by hand as they ship — the maths, the decisions, the bugs, and the model answers.</p>
      <span class="cta">Open the Field Notes →</span>
    </a>
  </div>

  <p class="foot-note">
    Progress lives in this browser and on the Notion campaign hub. Mocks, drills, and grills run with
    <code>/interview-buddy</code> — the Citadel is where you study; the buddy is where you bleed.
    Before any round, reread the <a href={`${BASE}stories/`}>interview stories</a> — what to say out loud, and how to claim it honestly.
  </p>
</Base>

<style>
  .hero { text-align: center; margin: 2rem 0 2.5rem; }
  .hero h1 { font-size: 2.4rem; }
  .sub { color: var(--text-dim); max-width: 52ch; margin: 0.5rem auto 0; }
  .tracks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  @media (max-width: 760px) { .tracks { grid-template-columns: 1fr; } }
  .track {
    display: block; padding: 1.6rem 1.5rem; border-radius: var(--radius);
    background: var(--bg-raised); border: 1px solid var(--border);
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, transform 0.15s;
  }
  .track:hover { transform: translateY(-2px); }
  .track.sd:hover { border-color: var(--blue); }
  .track.dsa:hover { border-color: var(--accent); }
  .track.lld:hover { border-color: var(--green); }
  .track.mastery:hover { border-color: var(--purple); }
  .track.field:hover { border-color: var(--red); }
  .track-icon { font-size: 2rem; }
  .track h2 { border: none; margin: 0.5rem 0 0.4rem; }
  .track p { color: var(--text-dim); font-size: 0.92rem; }
  .track.sd .cta { color: var(--blue); font-weight: 600; font-size: 0.92rem; }
  .track.dsa .cta { color: var(--accent); font-weight: 600; font-size: 0.92rem; }
  .track.lld .cta { color: var(--green); font-weight: 600; font-size: 0.92rem; }
  .track.mastery .cta { color: var(--purple); font-weight: 600; font-size: 0.92rem; }
  .track.field .cta { color: var(--red); font-weight: 600; font-size: 0.92rem; }
  .foot-note { text-align: center; color: var(--text-dim); font-size: 0.85rem; margin-top: 2.5rem; }
</style>
