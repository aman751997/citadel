---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BASE as base } from '../../paths';

const warPages = (await getCollection('war'))
  .filter((p) => p.id.startsWith('lld/'))
  .sort((a, b) => a.data.order - b.data.order);

// Theory forge queue — same planned-card treatment as the SD wing. Forged on demand.
const plannedModules = [
  {
    icon: '🏛️',
    title: 'Object design foundations',
    lessons: [
      { title: 'OOP mechanics that interviews test', description: 'Encapsulation, polymorphism, composition vs inheritance — with the failure each one prevents.' },
      { title: 'SOLID, problem-first', description: 'Each principle introduced by the mess you get without it, not the acronym.' },
    ],
  },
  {
    icon: '🧱',
    title: 'The pattern arsenal — theory',
    lessons: [
      { title: 'Creational patterns', description: 'Factory, builder, singleton-done-right — when object creation itself is the problem.' },
      { title: 'Structural patterns', description: 'Adapter, decorator, facade, proxy — wrapping and composing without exploding the class graph.' },
      { title: 'Behavioral patterns', description: 'Strategy, observer, state, template method, chain — runtime-varying behavior without if-else towers.' },
    ],
  },
  {
    icon: '🧵',
    title: 'Java concurrency for LLD rounds',
    lessons: [
      { title: 'Locks, atomics, thread pools', description: 'synchronized vs ReentrantLock vs atomics; ExecutorService sizing; producer-consumer from scratch.' },
    ],
  },
  {
    icon: '⏱️',
    title: 'Machine-coding playbook',
    lessons: [
      { title: 'The 90-minute protocol', description: 'Requirements → entities → interfaces → core flow → tests, with time boxes for each.' },
      { title: 'Classic problems', description: 'Parking lot, Splitwise, BookMyShow, LRU cache, rate limiter — the canon, each with a reference build.' },
    ],
  },
];
---
<Base title="LLD" description="Low-level design wing — pattern theory, machine-coding drills, and battle-tested dossiers from production code" track="lld">
  <header class="hero">
    <h1>🧩 The LLD Wing</h1>
    <p class="sub">
      Third pillar of the interview: low-level design and machine coding. Theory gets forged
      module by module like the SD wing; the War Room below holds the battle-tested material —
      18 pattern dossiers recovered from production code. Learn the theory, then read the dossier
      as the live example.
    </p>
  </header>

  {plannedModules.map((mod, i) => (
    <section class="module">
      <h2 class="module-title">{mod.icon} Module {i + 1} — {mod.title}</h2>
      <div class="lesson-grid">
        {mod.lessons.map((l) => (
          <div class="lesson-card planned">
            <span class="lesson-state">🛠️</span>
            <div>
              <div class="lesson-title">{l.title}</div>
              <div class="lesson-desc">{l.description}</div>
              <div class="lesson-meta">coming soon — forged on demand</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="module" id="war-room">
    <h2 class="module-title">⚔️ War Room — battle-tested, from production code</h2>
    <p class="module-tagline">
      Recovered from a multi-tenant hospital platform (22 Java/Spring microservices). Each dossier
      is the <strong>problem that forced the pattern</strong> — read alongside the theory as the
      live example, and reread the cheatsheet before the round.
    </p>
    <div class="lesson-grid">
      {warPages.map((p) => (
        <a href={`${base}lld/war/${p.id.replace('lld/', '')}/`} class="lesson-card">
          <span class="lesson-state">⚔️</span>
          <div>
            <div class="lesson-title">{p.data.title}</div>
            <div class="lesson-desc">{p.data.description}</div>
            <div class="lesson-meta">~{p.data.minutes} min</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { margin-bottom: 1.5rem; }
  .sub { color: var(--text-dim); max-width: 60ch; }
  .module { margin-top: 2.4rem; }
  .module-title { border: none; margin-bottom: 0.2rem; }
  .module-tagline { color: var(--text-dim); font-size: 0.92rem; margin-top: 0; }
  .lesson-grid { display: grid; gap: 0.7rem; margin-top: 1rem; }
  .lesson-card {
    display: flex; gap: 0.9rem; align-items: flex-start;
    padding: 0.95rem 1.1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, background 0.15s;
  }
  a.lesson-card:hover { border-color: var(--green); background: var(--bg-hover); }
  .lesson-card.planned { opacity: 0.45; }
  .lesson-state { font-size: 1.15rem; line-height: 1.5; }
  .lesson-title { font-weight: 600; }
  .lesson-desc { font-size: 0.86rem; color: var(--text-dim); margin-top: 0.15rem; }
  .lesson-meta { font-size: 0.75rem; color: var(--text-dim); font-family: var(--mono); margin-top: 0.35rem; }
</style>
