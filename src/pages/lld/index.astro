---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { LLD_MODULES } from '../../lld-modules';
import { BASE as base } from '../../paths';

const lessons = (await getCollection('lld')).sort(
  (a, b) => a.data.module - b.data.module || a.data.order - b.data.order
);
const orderedIds = lessons.map((l) => l.id);

const warPages = (await getCollection('war'))
  .filter((p) => p.id.startsWith('lld/'))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="LLD" description="Low-level design wing — pattern theory, machine-coding playbook, and battle-tested dossiers from production code" track="lld">
  <header class="hero">
    <h1>🧩 The LLD Wing</h1>
    <p class="sub">
      Third pillar of the interview: low-level design and machine coding. Every lesson is open: start anywhere.
      The “▶ next” badge marks the next one in the suggested order. The War Room below holds the battle-tested material from
      production code: learn the theory, then read the dossier as the live example.
    </p>
    <div class="progress-wrap">
      <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
      <span class="progress-label" id="progress-label">0 / {lessons.length} lessons</span>
      <button id="copy-progress" type="button" title="Copy progress report to paste to the buddy">📋 Copy progress</button>
    </div>
  </header>

  {LLD_MODULES.map((mod) => {
    const modLessons = lessons.filter((l) => l.data.module === mod.id);
    return (
      <section class="module">
        <h2 class="module-title">{mod.icon} Module {mod.id} — {mod.title}</h2>
        <p class="module-tagline">{mod.tagline}</p>
        <div class="lesson-grid">
          {modLessons.map((l) => (
            <div class="lesson-card" data-lesson-id={l.id} data-unlock-order={orderedIds.indexOf(l.id)}>
              <label class="check-hit">
                <input type="checkbox" class="lesson-check" aria-label={`Mark ${l.data.title} as done`} />
              </label>
              <a class="lesson-link" href={`${base}lld/lessons/${l.id}/`}>
                <div class="lesson-title">{l.data.title} <span class="next-badge" hidden>▶ next</span></div>
                <div class="lesson-desc">{l.data.description}</div>
                <div class="lesson-meta">~{l.data.minutes} min</div>
              </a>
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <section class="module" id="war-room">
    <h2 class="module-title">⚔️ War Room — battle-tested, from production code</h2>
    <p class="module-tagline">
      Recovered from a multi-tenant hospital platform (22 Java/Spring microservices). Each dossier
      is the <strong>problem that forced the pattern</strong> — the lessons above link into these
      as live examples. The cheatsheet is your pre-round reread.
    </p>
    <div class="lesson-grid">
      {warPages.map((p) => (
        <a href={`${base}lld/war/${p.id.replace('lld/', '')}/`} class="lesson-card war-card">
          <span class="lesson-state">⚔️</span>
          <div>
            <div class="lesson-title">{p.data.title}</div>
            <div class="lesson-desc">{p.data.description}</div>
            <div class="lesson-meta">~{p.data.minutes} min</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { margin-bottom: 1.5rem; }
  .sub { color: var(--text-dim); max-width: 60ch; }
  .progress-wrap { display: flex; align-items: center; gap: 0.9rem; margin-top: 1.1rem; }
  .progress-bar {
    flex: 1; height: 10px; background: var(--bg-raised);
    border: 1px solid var(--border); border-radius: 99px; overflow: hidden;
  }
  .progress-fill {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #2ea043, var(--green));
    border-radius: 99px; transition: width 0.5s ease;
  }
  .progress-label { font-size: 0.82rem; color: var(--text-dim); font-family: var(--mono); white-space: nowrap; }
  #copy-progress {
    background: var(--bg-raised); color: var(--text); border: 1px solid var(--border);
    border-radius: 7px; padding: 0.35rem 0.8rem; font-size: 0.8rem; font-family: inherit;
    cursor: pointer; white-space: nowrap;
  }
  #copy-progress:hover { border-color: var(--green); }
  #copy-progress.copied { border-color: var(--green); color: var(--green); }
  .module { margin-top: 2.4rem; }
  .module-title { border: none; margin-bottom: 0.2rem; }
  .module-tagline { color: var(--text-dim); font-size: 0.92rem; margin-top: 0; }
  .lesson-grid { display: grid; gap: 0.7rem; margin-top: 1rem; }
  .lesson-card {
    display: flex; gap: 0.9rem; align-items: flex-start;
    padding: 0.95rem 1.1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, background 0.15s;
  }
  a.lesson-card:hover { border-color: var(--green); background: var(--bg-hover); }
  .lesson-card:has(.lesson-link:hover) { border-color: var(--green); background: var(--bg-hover); }
  .lesson-card.done { border-color: rgba(63, 185, 80, 0.45); }
  .lesson-state { font-size: 1.15rem; line-height: 1.5; }
  .lesson-card:has(.check-hit) { padding: 0; gap: 0; align-items: stretch; }
  .check-hit { display: flex; align-items: flex-start; justify-content: center; flex: 0 0 44px; min-height: 44px; padding-top: 0.75rem; cursor: pointer; }
  .lesson-check { width: 1.25rem; height: 1.25rem; margin: 0; cursor: pointer; accent-color: var(--green); }
  .lesson-check:disabled { cursor: default; }
  .lesson-check:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .lesson-link { flex: 1; min-width: 0; padding: 0.95rem 1.1rem 0.95rem 0.2rem; color: var(--text); text-decoration: none; }
  .next-badge { font-size: 0.7rem; font-family: var(--mono); color: var(--accent); border: 1px solid var(--accent-dim); border-radius: 4px; padding: 0 0.35rem; margin-left: 0.4rem; white-space: nowrap; }
  .lesson-title { font-weight: 600; }
  .lesson-desc { font-size: 0.86rem; color: var(--text-dim); margin-top: 0.15rem; }
  .lesson-meta { font-size: 0.75rem; color: var(--text-dim); font-family: var(--mono); margin-top: 0.35rem; }
</style>

<script>
  import { LLD_DONE } from '../../progress';
  import { queueSync } from '../../sync';
  import { getList, toggleItem } from '../../lib/lesson-check.ts';
  // Baked (git-synced) completions + localStorage overlay of NEW ones not yet synced.
  const KEY = 'sdc-lld-progress';
  const baked = new Set<string>(LLD_DONE);
  const freshIds = () => getList(KEY).filter((s) => !baked.has(s));
  const isDone = (id: string) => baked.has(id) || getList(KEY).includes(id);
  // Drop overlay entries that are now baked into git.
  if (freshIds().length !== getList(KEY).length) {
    getList(KEY).filter((s) => baked.has(s)).forEach((s) => toggleItem(KEY, s, false));
  }
  const cards = [...document.querySelectorAll<HTMLElement>('[data-lesson-id]')].sort(
    (a, b) => Number(a.dataset.unlockOrder) - Number(b.dataset.unlockOrder)
  );
  const fill = document.getElementById('progress-fill');
  const label = document.getElementById('progress-label');
  const total = cards.length;
  let doneCount = 0;
  const refresh = () => {
    let nextMarked = false;
    doneCount = 0;
    for (const card of cards) {
      const id = card.dataset.lessonId!;
      const box = card.querySelector<HTMLInputElement>('.lesson-check')!;
      const badge = card.querySelector<HTMLElement>('.next-badge')!;
      const d = isDone(id);
      box.checked = d;
      if (baked.has(id)) {
        box.disabled = true;
        box.closest('label')!.title = 'Recorded in git sync';
      }
      card.classList.toggle('done', d);
      if (d) doneCount++;
      badge.hidden = d || nextMarked;
      if (!d) nextMarked = true;
    }
    if (fill && total > 0) fill.style.width = `${(doneCount / total) * 100}%`;
    if (label) label.textContent = `${doneCount} / ${total} lessons`;
  };
  refresh();
  window.addEventListener('pageshow', (e) => { if (e.persisted) refresh(); });
  for (const card of cards) {
    const box = card.querySelector<HTMLInputElement>('.lesson-check')!;
    box.addEventListener('change', () => {
      toggleItem(KEY, card.dataset.lessonId!, box.checked);
      if (box.checked) queueSync();
      refresh();
    });
  }

  // Copy-progress: structured report to paste to the buddy, who logs it to Notion + repo.
  const copyBtn = document.getElementById('copy-progress') as HTMLButtonElement | null;
  copyBtn?.addEventListener('click', async () => {
    const clearedIds = cards.filter((c) => isDone(c.dataset.lessonId!)).map((c) => c.dataset.lessonId);
    const newIds = freshIds().filter((s) => cards.some((c) => c.dataset.lessonId === s));
    const nextCard = cards.find((c) => !isDone(c.dataset.lessonId!));
    const report = [
      `🧩 LLD progress report — ${new Date().toISOString().slice(0, 10)}`,
      `Lessons cleared (${doneCount}/${total}): ${clearedIds.length ? clearedIds.join(', ') : 'none yet'}`,
      `NEW since last sync (${newIds.length}): ${newIds.length ? newIds.join(', ') : 'none'}`,
      `Next up: ${nextCard ? nextCard.dataset.lessonId : 'all lessons cleared — drill time'}`,
      `(paste this to /interview-buddy → NEW ids get baked into src/progress.ts + Notion, then committed)`,
    ].join('\n');
    try {
      await navigator.clipboard.writeText(report);
      copyBtn.classList.add('copied');
      copyBtn.textContent = '✅ Copied — paste to buddy';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyBtn.textContent = '📋 Copy progress';
      }, 2500);
    } catch {
      window.prompt('Copy your LLD progress report:', report);
    }
  });
</script>
