---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { MASTERY_PROJECTS } from '../../../mastery-projects';
import { BASE as base } from '../../../paths';

export async function getStaticPaths() {
  const chapters = await getCollection('mastery');
  return chapters.map((chapter) => {
    const [project, ...rest] = chapter.id.split('/');
    return { params: { project, chapter: rest.join('/') }, props: { chapter } };
  });
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);

const project = MASTERY_PROJECTS.find((p) => p.slug === chapter.data.project);
const siblings = (await getCollection('mastery'))
  .filter((c) => c.data.project === chapter.data.project)
  .sort((a, b) => a.data.order - b.data.order);
const idx = siblings.findIndex((c) => c.id === chapter.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const href = (id: string) => `${base}mastery/${id.replace('/', '/')}/`;
---
<Base title={chapter.data.title} description={chapter.data.description} track="mastery">
  <article>
    <p class="crumb">
      <a href={`${base}mastery/`}>← Mastery</a> ·
      <a href={`${base}mastery/${chapter.data.project}/`}>{project?.icon} {project?.title ?? chapter.data.project}</a>
      · chapter {idx + 1} of {siblings.length} · ~{chapter.data.minutes} min
    </p>
    <h1>{chapter.data.title}</h1>
    <p class="lede">{chapter.data.description}</p>
    <hr />
    <Content />

    {chapter.data.source && (
      <p class="source-note">
        Synced from <a href={chapter.data.source} target="_blank" rel="noopener">the Confluence original ↗</a>
        {chapter.data.synced ? ` on ${chapter.data.synced}` : ''}. Edit there, then re-run the sync script.
      </p>
    )}

    <nav class="lesson-nav">
      {prev ? <a href={href(prev.id)}>← {prev.data.title}</a> : <span />}
      {next ? <a href={href(next.id)} class="next">{next.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .crumb { font-size: 0.85rem; color: var(--text-dim); }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--text); }
  .lede { color: var(--text-dim); font-size: 1.05rem; margin-top: 0; }
  .source-note {
    margin-top: 2.5rem; padding: 0.7rem 1rem;
    border: 1px dashed var(--border); border-radius: var(--radius);
    font-size: 0.82rem; color: var(--text-dim);
  }
  .lesson-nav {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .lesson-nav a { text-decoration: none; }
</style>
