---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { MASTERY_PROJECTS } from '../../../mastery-projects';
import { BASE as base } from '../../../paths';

export async function getStaticPaths() {
  const chapters = await getCollection('mastery');
  return MASTERY_PROJECTS.filter((p) => chapters.some((c) => c.data.project === p.slug)).map((project) => ({
    params: { project: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const chapters = (await getCollection('mastery'))
  .filter((c) => c.data.project === project.slug)
  .sort((a, b) => a.data.order - b.data.order);
const minutes = chapters.reduce((s, c) => s + c.data.minutes, 0);
const chapterSlug = (id: string) => id.replace(`${project.slug}/`, '');
---
<Base title={project.title} description={project.tagline} track="mastery">
  <p class="crumb"><a href={`${base}mastery/`}>← Mastery Wing</a></p>
  <header class="hero">
    <h1>{project.icon} {project.title}</h1>
    <p class="sub">{project.tagline}</p>
    <p class="meta">
      {chapters.length} chapters · ~{minutes} min · <span id="chapters-done">0</span>/{chapters.length} done
    </p>
  </header>

  <div class="chapter-list">
    {chapters.map((c, i) => (
      <div class="chapter">
        <label class="check-hit">
          <input type="checkbox" class="chapter-check" data-chapter={`${project.slug}/${chapterSlug(c.id)}`} aria-label={`Mark chapter ${c.data.title} as done`} />
        </label>
        <a class="chapter-link" href={`${base}mastery/${project.slug}/${chapterSlug(c.id)}/`}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <div class="chapter-title">{c.data.title}</div>
            <div class="chapter-desc">{c.data.description}</div>
            <div class="chapter-meta">~{c.data.minutes} min</div>
          </div>
        </a>
      </div>
    ))}
  </div>
</Base>

<style>
  .crumb { font-size: 0.85rem; color: var(--text-dim); }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--text); }
  .hero { margin-bottom: 1.8rem; }
  .sub { color: var(--text-dim); max-width: 64ch; }
  .meta { font-family: var(--mono); font-size: 0.78rem; color: var(--text-dim); }
  .chapter-list { display: grid; gap: 0.6rem; }
  .chapter {
    display: flex; align-items: stretch;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, background 0.15s;
  }
  .check-hit { display: flex; align-items: flex-start; justify-content: center; flex: 0 0 44px; min-height: 44px; padding-top: 0.75rem; cursor: pointer; }
  .chapter-check { width: 1.25rem; height: 1.25rem; margin: 0; cursor: pointer; accent-color: var(--green); }
  .chapter-check:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .chapter-link { flex: 1; min-width: 0; display: flex; gap: 1rem; align-items: flex-start; padding: 0.95rem 1.1rem 0.95rem 0.2rem; color: var(--text); text-decoration: none; }
  .chapter.done { border-color: rgba(63, 185, 80, 0.45); }
  .chapter:has(.chapter-link:hover) { border-color: var(--purple); background: var(--bg-hover); }
  .num { font-family: var(--mono); font-size: 0.95rem; color: var(--purple); font-weight: 700; padding-top: 0.1rem; }
  .chapter-title { font-weight: 600; }
  .chapter-desc { font-size: 0.86rem; color: var(--text-dim); margin-top: 0.15rem; }
  .chapter-meta { font-size: 0.75rem; color: var(--text-dim); font-family: var(--mono); margin-top: 0.35rem; }
</style>

<script>
  import { getList, toggleItem } from '../../../lib/lesson-check.ts';
  const KEY = 'citadel-mastery-chapters-done-v1';
  const boxes = [...document.querySelectorAll<HTMLInputElement>('.chapter-check')];
  const counter = document.getElementById('chapters-done');
  const paint = () => {
    const list = getList(KEY);
    let n = 0;
    for (const b of boxes) {
      b.checked = list.includes(b.dataset.chapter!);
      b.closest('.chapter')!.classList.toggle('done', b.checked);
      if (b.checked) n++;
    }
    if (counter) counter.textContent = String(n);
  };
  paint();
  window.addEventListener('pageshow', (e) => { if (e.persisted) paint(); });
  boxes.forEach((b) => b.addEventListener('change', () => { toggleItem(KEY, b.dataset.chapter!, b.checked); paint(); }));
</script>
