---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MASTERY_PROJECTS } from '../../mastery-projects';
import { BASE as base } from '../../paths';

const chapters = await getCollection('mastery');
const byProject = (slug: string) =>
  chapters.filter((c) => c.data.project === slug).sort((a, b) => a.data.order - b.data.order);

const projects = MASTERY_PROJECTS.map((p) => {
  const own = byProject(p.slug);
  return { ...p, chapters: own, minutes: own.reduce((s, c) => s + c.data.minutes, 0) };
}).filter((p) => p.chapters.length > 0);

const totalChapters = projects.reduce((s, p) => s + p.chapters.length, 0);
const totalMinutes = projects.reduce((s, p) => s + p.minutes, 0);
---
<Base
  title="Mastery"
  description="Project mastery dossiers — the systems you actually built, written up to interview depth"
  track="mastery"
>
  <header class="hero">
    <h1>📓 The Mastery Wing</h1>
    <p class="sub">
      The other half of every loop: not "design Twitter", but <em>"walk me through something you built."</em>
      Each dossier takes one production system you shipped and drills it to interview depth — architecture,
      the decisions and their trade-offs, the bugs that taught you something, and a question bank with model answers.
    </p>
    <p class="stat">{projects.length} dossiers · {totalChapters} chapters · ~{Math.round(totalMinutes / 60)}h of reading</p>
  </header>

  <div class="project-grid">
    {projects.map((p) => (
      <a class="project" href={`${base}mastery/${p.slug}/`}>
        <div class="project-icon">{p.icon}</div>
        <div>
          <h2>{p.title}</h2>
          <p class="tagline">{p.tagline}</p>
          <p class="meta">{p.chapters.length} chapters · ~{p.minutes} min</p>
        </div>
      </a>
    ))}
  </div>

  <p class="foot-note">
    Source of truth is the Confluence space; these pages are generated from it by
    <code>scripts/confluence-to-mdx.mjs</code>, so re-running the sync picks up edits made in the wiki.
    Read a dossier before any round where this work is on your résumé.
  </p>
</Base>

<style>
  .hero { margin-bottom: 2rem; }
  .sub { color: var(--text-dim); max-width: 64ch; }
  .stat { font-family: var(--mono); font-size: 0.82rem; color: var(--purple); }
  .project-grid { display: grid; gap: 0.9rem; }
  .project {
    display: flex; gap: 1.1rem; align-items: flex-start;
    padding: 1.3rem 1.4rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, background 0.15s;
  }
  .project:hover { border-color: var(--purple); background: var(--bg-hover); }
  .project-icon { font-size: 1.8rem; line-height: 1.2; }
  .project h2 { border: none; margin: 0 0 0.3rem; font-size: 1.18rem; }
  .tagline { color: var(--text-dim); font-size: 0.9rem; margin: 0; }
  .meta { font-family: var(--mono); font-size: 0.75rem; color: var(--text-dim); margin: 0.5rem 0 0; }
  .foot-note { color: var(--text-dim); font-size: 0.85rem; margin-top: 2.5rem; }
</style>
