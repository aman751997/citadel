---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MODULES } from '../../modules';

const lessons = (await getCollection('lessons')).sort(
  (a, b) => a.data.module - b.data.module || a.data.order - b.data.order
);
const caseStudies = (await getCollection('war'))
  .filter((p) => p.id.startsWith('sd/'))
  .sort((a, b) => a.data.order - b.data.order);
import { BASE as base } from '../../paths';

// Global unlock order: flat list of lesson ids in curriculum order
const orderedIds = lessons.map((l) => l.id);
---
<Base title="System Design" track="sd">
  <header class="hero">
    <h1>🏗️ The System Design Wing</h1>
    <p class="sub">
      Your private Hello-Interview, pattern-first: Lessons unlock in order — finish one, the next gate opens.
      Progress saves in this browser. New lessons get forged as you climb.
    </p>
    <div class="progress-wrap">
      <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
      <span class="progress-label" id="progress-label">0 / {lessons.length} lessons</span>
      <button id="copy-progress" type="button" title="Copy progress report to paste to the buddy">📋 Copy progress</button>
    </div>
  </header>

  {MODULES.map((mod) => {
    const modLessons = lessons.filter((l) => l.data.module === mod.id);
    return (
      <section class="module">
        <h2 class="module-title">{mod.icon} Module {mod.id} — {mod.title}</h2>
        <p class="module-tagline">{mod.tagline}</p>
        <div class="lesson-grid">
          {modLessons.map((l) => (
            <a
              href={`${base}sd/lessons/${l.id}/`}
              class="lesson-card"
              data-lesson-id={l.id}
              data-unlock-order={orderedIds.indexOf(l.id)}
            >
              <span class="lesson-state" data-state-icon>🔒</span>
              <div>
                <div class="lesson-title">{l.data.title}</div>
                <div class="lesson-desc">{l.data.description}</div>
                <div class="lesson-meta">~{l.data.minutes} min</div>
              </div>
            </a>
          ))}
          {mod.planned.map((p) => (
            <div class="lesson-card planned">
              <span class="lesson-state">🛠️</span>
              <div>
                <div class="lesson-title">{p.title}</div>
                <div class="lesson-desc">{p.description}</div>
                <div class="lesson-meta">coming soon — forged on demand</div>
              </div>
            </div>
          ))}
        </div>
      </section>
    );
  })}

  <section class="module" id="war-room">
    <h2 class="module-title">⚔️ War Room — case studies from production</h2>
    <p class="module-tagline">
      Six deep dives recovered from a multi-tenant hospital platform and an event-driven AI pipeline.
      Each doubles as a complete HLD answer with the trade-offs already argued — read after the theory
      module it echoes, as the live example. No gates here.
    </p>
    <div class="lesson-grid">
      {caseStudies.map((p) => (
        <a href={`${base}sd/war/${p.id.replace('sd/', '')}/`} class="lesson-card war-card">
          <span class="lesson-state">⚔️</span>
          <div>
            <div class="lesson-title">{p.data.title}</div>
            <div class="lesson-desc">{p.data.description}</div>
            <div class="lesson-meta">~{p.data.minutes} min</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { margin-bottom: 1.5rem; }
  .sub { color: var(--text-dim); max-width: 60ch; }
  .progress-wrap { display: flex; align-items: center; gap: 0.9rem; margin-top: 1.1rem; }
  .progress-bar {
    flex: 1; height: 10px; background: var(--bg-raised);
    border: 1px solid var(--border); border-radius: 99px; overflow: hidden;
  }
  .progress-fill {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, var(--accent-dim), var(--accent));
    border-radius: 99px; transition: width 0.5s ease;
  }
  .progress-label { font-size: 0.82rem; color: var(--text-dim); font-family: var(--mono); white-space: nowrap; }
  #copy-progress {
    background: var(--bg-raised); color: var(--text); border: 1px solid var(--border);
    border-radius: 7px; padding: 0.35rem 0.8rem; font-size: 0.8rem; font-family: inherit;
    cursor: pointer; white-space: nowrap;
  }
  #copy-progress:hover { border-color: var(--accent-dim); }
  #copy-progress.copied { border-color: var(--green); color: var(--green); }
  .module { margin-top: 2.4rem; }
  .module-title { border: none; margin-bottom: 0.2rem; }
  .module-tagline { color: var(--text-dim); font-size: 0.92rem; margin-top: 0; }
  .lesson-grid { display: grid; gap: 0.7rem; margin-top: 1rem; }
  .lesson-card {
    display: flex; gap: 0.9rem; align-items: flex-start;
    padding: 0.95rem 1.1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none; color: var(--text);
    transition: border-color 0.15s, background 0.15s;
  }
  a.lesson-card:hover:not(.locked) { border-color: var(--accent-dim); background: var(--bg-hover); }
  a.war-card:hover { border-color: var(--green); }
  .lesson-card.locked { opacity: 0.55; pointer-events: none; }
  .lesson-card.done { border-color: rgba(63, 185, 80, 0.45); }
  .lesson-card.planned { opacity: 0.45; }
  .lesson-state { font-size: 1.15rem; line-height: 1.5; }
  .lesson-title { font-weight: 600; }
  .lesson-desc { font-size: 0.86rem; color: var(--text-dim); margin-top: 0.15rem; }
  .lesson-meta { font-size: 0.75rem; color: var(--text-dim); font-family: var(--mono); margin-top: 0.35rem; }
</style>

<script>
  const done: string[] = JSON.parse(localStorage.getItem('sdc-progress') || '[]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-lesson-id]')].sort(
    (a, b) => Number(a.dataset.unlockOrder) - Number(b.dataset.unlockOrder)
  );
  let gateOpen = true; // first incomplete lesson stays unlocked; everything after locks
  for (const card of cards) {
    const id = card.dataset.lessonId!;
    const icon = card.querySelector('[data-state-icon]')!;
    if (done.includes(id)) {
      card.classList.add('done');
      icon.textContent = '✅';
    } else if (gateOpen) {
      icon.textContent = '▶️';
      gateOpen = false;
    } else {
      card.classList.add('locked');
    }
  }
  const fill = document.getElementById('progress-fill');
  const label = document.getElementById('progress-label');
  const total = cards.length;
  const doneCount = cards.filter((c) => done.includes(c.dataset.lessonId!)).length;
  if (fill && total > 0) fill.style.width = `${(doneCount / total) * 100}%`;
  if (label) label.textContent = `${doneCount} / ${total} lessons`;

  // Copy-progress: structured report to paste to the buddy, who logs it to Notion + repo.
  const copyBtn = document.getElementById('copy-progress') as HTMLButtonElement | null;
  copyBtn?.addEventListener('click', async () => {
    const cleared = cards.filter((c) => done.includes(c.dataset.lessonId!));
    const clearedIds = cleared.map((c) => c.dataset.lessonId);
    const nextCard = cards.find((c) => !done.includes(c.dataset.lessonId!));
    const report = [
      `🏰 Citadel progress report — ${new Date().toISOString().slice(0, 10)}`,
      `SD lessons cleared (${doneCount}/${total}): ${clearedIds.length ? clearedIds.join(', ') : 'none yet'}`,
      `Next up: ${nextCard ? nextCard.dataset.lessonId : 'all lessons cleared'}`,
      `(paste this to /interview-buddy to sync Notion + the forge queue)`,
    ].join('\n');
    try {
      await navigator.clipboard.writeText(report);
      copyBtn.classList.add('copied');
      copyBtn.textContent = '✅ Copied — paste to buddy';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyBtn.textContent = '📋 Copy progress';
      }, 2500);
    } catch {
      // Clipboard API blocked (rare) — show the report so it can be copied manually
      window.prompt('Copy your progress report:', report);
    }
  });
</script>
