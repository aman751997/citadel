---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
import { BASE as base } from '../../../paths';

// prev/next in curriculum order
const all = (await getCollection('lessons')).sort(
  (a, b) => a.data.module - b.data.module || a.data.order - b.data.order
);
const idx = all.findIndex((l) => l.id === lesson.id);
const next = all[idx + 1];
const prev = all[idx - 1];
---
<Base title={lesson.data.title} description={lesson.data.description} track="sd">
  <article>
    <p class="crumb"><a href={`${base}sd/`}>← SD Roadmap</a> · Module {lesson.data.module} · ~{lesson.data.minutes} min</p>
    <h1>{lesson.data.title}</h1>
    <p class="lede">{lesson.data.description}</p>
    <hr />
    <Content />

    <div class="complete-box">
      <button id="complete-btn" data-lesson-id={lesson.id} type="button">
        ⚔️ Mark lesson complete
      </button>
      <p id="complete-msg" hidden>
        Cleared. {next ? 'Next gate is open on the roadmap.' : 'That was the last forged lesson — ask the buddy to forge the next one.'}
      </p>
    </div>

    <nav class="lesson-nav">
      {prev ? <a href={`${base}sd/lessons/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`${base}sd/lessons/${next.id}/`} id="next-link" class="next">{next.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .crumb { font-size: 0.85rem; color: var(--text-dim); }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--text); }
  .lede { color: var(--text-dim); font-size: 1.05rem; margin-top: 0; }
  .complete-box {
    margin: 2.5rem 0 1rem;
    padding: 1.2rem;
    border: 1px dashed var(--accent-dim);
    border-radius: var(--radius);
    text-align: center;
  }
  #complete-btn {
    background: var(--accent);
    color: #1a1400;
    font-weight: 700;
    font-size: 0.95rem;
    border: none;
    border-radius: 8px;
    padding: 0.65rem 1.4rem;
    cursor: pointer;
    font-family: inherit;
  }
  #complete-btn:hover { background: #f0c65a; }
  #complete-btn:disabled { background: var(--green); color: #04260c; cursor: default; }
  #complete-msg { color: var(--green); font-size: 0.9rem; margin-top: 0.7rem; }
  .lesson-nav {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .lesson-nav a { text-decoration: none; }
</style>

<script>
  import { SD_DONE } from '../../../progress';
  import { queueSync } from '../../../sync';
  const btn = document.getElementById('complete-btn') as HTMLButtonElement;
  const msg = document.getElementById('complete-msg');
  const id = btn.dataset.lessonId!;
  const key = 'sdc-progress';
  // Baked (git-synced) completions are truth; localStorage only holds NEW ones until synced.
  const local: string[] = JSON.parse(localStorage.getItem(key) || '[]');
  const synced = local.filter((s) => !SD_DONE.includes(s));
  if (synced.length !== local.length) {
    local.length = 0;
    local.push(...synced);
    localStorage.setItem(key, JSON.stringify(local));
  }
  const markDone = () => {
    btn.disabled = true;
    btn.textContent = '✅ Lesson cleared';
  };
  if (SD_DONE.includes(id) || local.includes(id)) markDone();
  btn.addEventListener('click', () => {
    if (!SD_DONE.includes(id) && !local.includes(id)) {
      local.push(id);
      localStorage.setItem(key, JSON.stringify(local));
      queueSync();
    }
    markDone();
    if (msg) msg.hidden = false;
  });
</script>
