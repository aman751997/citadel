---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { BASE } from '../../../paths';

export async function getStaticPaths() {
  const pages = (await getCollection('war')).filter((p) => p.id.startsWith('sd/'));
  return pages.map((page) => ({
    params: { slug: page.id.replace('sd/', '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const group = (await getCollection('war'))
  .filter((p) => p.id.startsWith('sd/'))
  .sort((a, b) => a.data.order - b.data.order);
const idx = group.findIndex((p) => p.id === page.id);
const prev = group[idx - 1];
const next = group[idx + 1];
---
<Base title={page.data.title} description={page.data.description} track="sd">
  <article>
    <p class="crumb"><a href={`${BASE}sd/#war-room`}>← SD Wing · War Room</a> · ⚔️ case study · ~{page.data.minutes} min</p>
    <h1>{page.data.title}</h1>
    <p class="lede">{page.data.description}</p>
    <hr />
    <Content />
    <nav class="lesson-nav">
      {prev ? <a href={`${BASE}sd/war/${prev.id.replace('sd/', '')}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`${BASE}sd/war/${next.id.replace('sd/', '')}/`} class="next">{next.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .crumb { font-size: 0.85rem; color: var(--text-dim); }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--text); }
  .lede { color: var(--text-dim); font-size: 1.05rem; margin-top: 0; }
  .lesson-nav {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .lesson-nav a { text-decoration: none; }
</style>
