---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BASE } from '../../paths';

const pages = (await getCollection('war')).sort((a, b) => a.data.order - b.data.order);
const lld = pages.filter((p) => p.id.startsWith('lld/'));
const sd = pages.filter((p) => p.id.startsWith('sd/'));
const stories = pages.filter((p) => !p.id.includes('/'));
const sections = [
  {
    icon: '🧩',
    title: 'LLD — Design Patterns',
    blurb:
      '18 patterns with their forcing problems, an honest grading of which ones the framework supplied, ' +
      'the 8 GoF patterns that are not there, and timed build drills. For machine-coding / LLD rounds.',
    pages: lld,
  },
  {
    icon: '🏗️',
    title: 'System Design — Case Studies',
    blurb:
      'Six deep dives that double as HLD answers: multi-tenant isolation, concurrency and races, ' +
      'searching encrypted data, event-driven pipeline architecture, hybrid RAG retrieval, and a failure-mode matrix.',
    pages: sd,
  },
  {
    icon: '🎙️',
    title: 'Interview Stories',
    blurb:
      'The same material rearranged as things you can say out loud — each with the setup, the decision, ' +
      'the trade-off you can defend, and the follow-up you should expect.',
    pages: stories,
  },
];
---
<Base title="The War Room" description="LLD patterns, system-design case studies, and interview stories — reverse-engineered from production code" track="war">
  <h1>🛡️ The War Room</h1>
  <p class="lede">
    Interview prep reverse-engineered from two real production codebases: a multi-tenant hospital
    platform (22 Java/Spring microservices, ~4,800 files) and an event-driven Python AI pipeline
    (NER + embeddings + RAG over patient records). Most material teaches the <em>shape</em> of a
    solution — this wing teaches the <strong>problem that forced it</strong>, recovered from the
    javadoc, design docs, and commit history the team left behind.
  </p>

  <h2>How every entry works</h2>
  <table>
    <thead><tr><th>Field</th><th>What it gives you</th></tr></thead>
    <tbody>
      <tr><td><strong>Problem</strong></td><td>The concrete situation. Not "when algorithms vary" — the actual thing that happened.</td></tr>
      <tr><td><strong>Without it</strong></td><td>What the naive version costs. This is what interviewers probe.</td></tr>
      <tr><td><strong>Evidence</strong></td><td>Where the reasoning is recorded. Quoted where the team stated it outright.</td></tr>
      <tr><td><strong>Trigger</strong></td><td>The recall cue — read the situation, and the answer should arrive.</td></tr>
    </tbody>
  </table>

  {sections.map((sec) => (
    <section class="wr-section">
      <h2>{sec.icon} {sec.title}</h2>
      <p class="blurb">{sec.blurb}</p>
      <ul class="pagelist">
        {sec.pages.map((p) => (
          <li>
            <a href={`${BASE}war/${p.id}/`}>{p.data.title}</a>
            <span class="mins">~{p.data.minutes} min</span>
            <p class="desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <blockquote>
    <p>
      <strong>On honesty in interviews.</strong> Some of this is work you did, some is work you
      reviewed, some is work an AI wrote and you now understand. Those are three different claims.
      Say which one it is — "I own this", "I reviewed this", "I dug into why this was built this
      way". The last one is still a strong answer, and it survives follow-ups that a borrowed
      claim won't.
    </p>
  </blockquote>

  <p class="foot">
    Start with <a href={`${BASE}war/lld/patterns-why/`}>Why each pattern exists</a> and
    <a href={`${BASE}war/sd/multi-tenancy/`}>Multi-tenant isolation</a> — those two carry the most
    weight per page.
  </p>
</Base>

<style>
  .lede { color: var(--text-dim); font-size: 1.02rem; }
  .wr-section { margin-top: 2rem; }
  .blurb { color: var(--text-dim); font-size: 0.92rem; }
  .pagelist { list-style: none; padding: 0; }
  .pagelist li {
    padding: 0.7rem 1rem; margin: 0.5rem 0;
    background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius);
  }
  .pagelist a { font-weight: 600; text-decoration: none; }
  .mins { font-size: 0.78rem; color: var(--text-dim); font-family: var(--mono); margin-left: 0.6rem; }
  .desc { margin: 0.25rem 0 0; color: var(--text-dim); font-size: 0.86rem; }
  .foot { margin-top: 2rem; }
</style>
